# AP-14 IP-18: Umgebung des Dauerläufers (uems_dauerlaeufer.py). NUR Namen und Form -
# hier steht nie ein Geheimnis. In Produktion kommen die Kennungen aus dem Kundenbereich
# "VoltPilot Dauerläufer (intern)" und die Zertifikate aus dem Kubernetes-Secret
# `voltpilot-dauerlaeufer-boxen` (Schlüssel e1.crt, e1.key, e2.crt, e2.key, ca.crt).
# Punktschlüssel stehen hier NICHT: der Simulator lernt sie aus der Mess-Auswahl, die die
# Plattform jeder Box gehalten zustellt (v2/measurement-config), und quittiert sie (Drehbuch §14.2).

# ---- Broker (mTLS, wie eine echte Box) ----
VP_DAUERLAEUFER_BROKER=mqtt.example.com
VP_DAUERLAEUFER_PORT=8883
VP_DAUERLAEUFER_TLS=1
VP_DAUERLAEUFER_CA=/geheim/ca.crt

# ---- Kundenbereich: die interne UUID (dieselbe wie VOLTPILOT_UEMS_DAUERLAEUFER_TENANT) ----
VP_DAUERLAEUFER_TENANT=00000000-0000-0000-0000-000000000000

# ---- Box E-1 (Halle 1, MS-05…MS-08): Anlage, Gerät, Zertifikat ----
VP_DAUERLAEUFER_E1_SITE=00000000-0000-0000-0000-000000000000
VP_DAUERLAEUFER_E1_DEVICE=00000000-0000-0000-0000-000000000000
VP_DAUERLAEUFER_E1_CERT=/geheim/e1.crt
VP_DAUERLAEUFER_E1_KEY=/geheim/e1.key

# ---- Box E-2 (Halle 2, MS-10…MS-14) ----
VP_DAUERLAEUFER_E2_SITE=00000000-0000-0000-0000-000000000000
VP_DAUERLAEUFER_E2_DEVICE=00000000-0000-0000-0000-000000000000
VP_DAUERLAEUFER_E2_CERT=/geheim/e2.crt
VP_DAUERLAEUFER_E2_KEY=/geheim/e2.key

# ---- Lebenszeichen für die Probe (Vorgabe) ----
# VP_DAUERLAEUFER_LEBENSZEICHEN=/tmp/dauerlaeufer-lebenszeichen
