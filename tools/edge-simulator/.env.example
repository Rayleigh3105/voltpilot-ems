# VoltPilot edge simulator - example config.
# Copy to `.env` (next to the script, or point at it with --env-file) and edit.
# CLI flags override these; these override the built-in defaults.
# All values here are DEV defaults - never reuse secrets outside local dev.

# ---- Broker / transport ----
EDGE_SIM_HOST=localhost
EDGE_SIM_PORT=1883
# TLS auto-enables on port 8883 or when a client cert is set. Force with these:
# EDGE_SIM_TLS=true
# EDGE_SIM_CA_CERT=/certs/device-ca.crt
# EDGE_SIM_CLIENT_CERT=/certs/device.crt
# EDGE_SIM_CLIENT_KEY=/certs/device.key
# Dev-only: skip broker cert verification (do NOT use in prod). Normally
# unneeded - the CA tool puts both the FQDN and IP in the broker cert SAN:
# EDGE_SIM_INSECURE=false
# Plain-broker auth (leave unset for mTLS - the broker derives the user from the cert CN):
# EDGE_SIM_USERNAME=
# EDGE_SIM_PASSWORD=

# ---- Device identity (defaults mirror the `demo` dev seed) ----
EDGE_SIM_TENANT_ID=00000000-0000-0000-0000-000000000001
EDGE_SIM_SITE_ID=00000000-0000-0000-0000-000000000002
EDGE_SIM_DEVICE_ID=00000000-0000-0000-0000-000000000003

# ---- Cadence ----
EDGE_SIM_INTERVAL=5
EDGE_SIM_STATUS_INTERVAL=30
# EDGE_SIM_COUNT=0        # 0 = run forever; N = stop after N telemetry messages

# ---- Simulation shape ----
# Profile = day shape + which fields the device reports:
#   pv-haus           residential PV + battery + household load (default; reports
#                     power/soc/pv/load/grid_limit).
#   gewerbe-steuernd  industrial site that generates and steers: shift load + PV +
#                     a Lastspitzenkappung battery (reports all fields).
#   gewerbe-mess      pure-measurement industrial site: shift load only, grid draw
#                     never negative, no PV/battery (reports power/load/grid_limit).
EDGE_SIM_PROFILE=pv-haus
# time-scale 1 = realtime (curve tracks the real clock). e.g. 288 plays a full
# day in 5 minutes so a demo shows a plausible day quickly.
EDGE_SIM_TIME_SCALE=1
# EDGE_SIM_START_HOUR=12  # start the sim day at this hour (default: real clock)
EDGE_SIM_PV_PEAK_KW=8.0
EDGE_SIM_LOAD_BASE_KW=0.35
EDGE_SIM_BATT_CAPACITY_KWH=10.0
EDGE_SIM_BATT_MAX_KW=5.0
EDGE_SIM_SOC_INIT_PCT=40
EDGE_SIM_GRID_LIMIT_KW=11.0
EDGE_SIM_NOISE=0.04
# EDGE_SIM_SEED=42        # deterministic noise (tests/proofs)
EDGE_SIM_VERBOSE=false

# ---- Commercial/industrial shape (gewerbe-* profiles only) ----
# LOAD_BASE_KW is the night/weekend floor; LOAD_PEAK_KW is the production load
# added on top during the weekday shift. The peak stays under GRID_LIMIT_KW
# (the agreed connection power) so the 15-min Lastspitze is visible but plausible.
# EDGE_SIM_LOAD_PEAK_KW=120
# EDGE_SIM_SHIFT_START_HOUR=6
# EDGE_SIM_SHIFT_END_HOUR=22
# EDGE_SIM_WEEKEND_FACTOR=0.15     # fraction of weekday production kept Sat/Sun
# gewerbe-steuernd only:
# EDGE_SIM_PEAK_GRID_KW=300        # Lastspitzenkappung target for grid import (0 = off)
# EDGE_SIM_EXPORT_LIMIT_KW=100     # Einspeisegrenze: PV feed-in capped at this many kW
