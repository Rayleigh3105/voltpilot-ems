    {"name": "Option B ohne Stufen: kleiner Sollwert bleibt aus", "config": {"ip": "192.168.178.43", "channels": [0, 1, 2], "output_kw": [2.0, 2.0, 2.0]}, "command": {"setpoint_kw": 2.0, "control_enabled": true}, "day": 0,
