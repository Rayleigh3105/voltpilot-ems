     "expect": {"mode": "on", "stage": 1, "stage_kw": 2.0, "targets": [true, false, false], "write": true}},
    {"name": "ein laufender Ausgang bleibt über den Tageswechsel", "config": {"ip": "192.168.178.43", "channels": [0, 1, 2], "output_kw": [2.0, 2.0, 2.0], "stages": [1, 2, 3]}, "command": {"setpoint_kw": 2.0, "control_enabled": true}, "day": 20393,
