{
  "$comment": [
    "Heizstab in Stufen über eine Ausgangsmenge (Vertrag: heizstab-shelly.md).",
    "Gelesen von: edge-app/core/internal/shelly/group_vectors_test.go (Box: Prüfung, Stufenwahl, Rücklesung).",
    "Die API (Treiberblock, Ledger mit kW der bestätigten Stufe) liest dieselbe Datei, sobald sie den Block baut."
  ],
  "$regel": "config = die Felder des Treiberblocks (driver.connection). prev = was der letzte Durchlauf befahl (commanded) und las (read: true/false/null je Ausgang, Reihenfolge wie channels). day = Rotationstag (UTC-Tage seit 1970). targets/counted/read/outputs sind je Ausgang in der Reihenfolge von channels.",
  "validate": [
    {"name": "Pro 3, drei Phasen, Stufen 1/2/3", "config": {"ip": "192.168.178.43", "channels": [0, 1, 2], "output_kw": [2.0, 2.0, 2.0], "stages": [1, 2, 3]}, "error": ""},
    {"name": "ohne Stufen nur alle zusammen, großes Element erlaubt", "config": {"ip": "192.168.178.43", "channels": [0, 1, 2], "output_kw": [5.0, 5.0, 5.0]}, "error": ""},
    {"name": "Ausgang doppelt", "config": {"ip": "192.168.178.43", "channels": [0, 0], "output_kw": [2.0, 2.0]}, "error": "Ausgang 0 steht zweimal in der Ausgangsmenge."},
    {"name": "Leistung fehlt", "config": {"ip": "192.168.178.43", "channels": [0, 1, 2]}, "error": "Für jeden Ausgang fehlt die Leistung seines Heizelements (kW)."},
    {"name": "Leistung null", "config": {"ip": "192.168.178.43", "channels": [0, 1], "output_kw": [2.0, 0]}, "error": "Die Leistung jedes Heizelements muss größer als 0 sein."},
    {"name": "Ausgang außerhalb 0-3", "config": {"ip": "192.168.178.43", "channels": [0, 4], "output_kw": [2.0, 2.0]}, "error": "Der Schaltkanal muss zwischen 0 und 3 liegen."},
    {"name": "fünf Ausgänge", "config": {"ip": "192.168.178.43", "channels": [0, 1, 2, 3, 3], "output_kw": [1, 1, 1, 1, 1]}, "error": "Ein Gerät umfasst höchstens vier Ausgänge."},
    {"name": "Stufen nicht aufsteigend", "config": {"ip": "192.168.178.43", "channels": [0, 1, 2], "output_kw": [2.0, 2.0, 2.0], "stages": [3, 1]}, "error": "Die Stufen müssen aufsteigend zwischen 1 und der Zahl der Ausgänge liegen."},
    {"name": "Stufe größer als die Menge", "config": {"ip": "192.168.178.43", "channels": [0, 1], "output_kw": [2.0, 2.0], "stages": [1, 3]}, "error": "Die Stufen müssen aufsteigend zwischen 1 und der Zahl der Ausgänge liegen."},
    {"name": "Einzelphase mit Element über 4,6 kW (Schieflast)", "config": {"ip": "192.168.178.43", "channels": [0, 1, 2], "output_kw": [5.0, 5.0, 5.0], "stages": [1, 3]}, "error": "Einzelne Phasen gibt es nur mit Heizelementen bis 4,6 kW (Schieflast) - dieser Heizstab schaltet nur alle Ausgänge zusammen."},
    {"name": "unbekannte Phasenwahl", "config": {"ip": "192.168.178.43", "channels": [0, 1, 2], "output_kw": [2.0, 2.0, 2.0], "stages": [1, 3], "rotation": "weekly"}, "error": "Unbekannte Phasenwahl für Stufe 1."}
  ],
  "plan": [
    {"name": "an = höchste erlaubte Stufe", "config": {"ip": "192.168.178.43", "channels": [0, 1, 2], "output_kw": [2.0, 2.0, 2.0], "stages": [1, 2, 3]}, "command": {"on_off": true, "control_enabled": true}, "day": 0,
     "expect": {"mode": "on", "stage": 3, "stage_kw": 6.0, "targets": [true, true, true], "write": true, "timer_s": 180, "reason": "Einschalten mit Abfall-Timer (Totmann-Schutz)"}},
