    {"name": "Option B ohne Stufen: an = alle", "config": {"ip": "192.168.178.43", "channels": [0, 1, 2], "output_kw": [2.0, 2.0, 2.0]}, "command": {"on_off": true, "control_enabled": true}, "day": 0,
