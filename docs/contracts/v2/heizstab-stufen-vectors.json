    {"name": "HZ-4 B: Ausgang hat nicht eingeschaltet - derselbe wird neu versucht", "config": {"ip": "192.168.178.43", "channels": [0, 1, 2], "output_kw": [2.0, 2.0, 2.0], "stages": [1, 2, 3]}, "command": {"setpoint_kw": 4.0, "control_enabled": true}, "day": 20394,
