     "expect": {"mode": "off", "stage": 0, "stage_kw": 0, "targets": [false, false, false], "write": true, "reason": "Sollwert unter der kleinsten Stufe - alle Ausgänge bleiben aus (nie mehr liefern als befohlen)"}},
    {"name": "ohne frischen Befehl alle aus", "config": {"ip": "192.168.178.43", "channels": [0, 1, 2], "output_kw": [2.0, 2.0, 2.0], "stages": [1, 2, 3]}, "command": {"stale": true, "control_enabled": true}, "day": 0,
     "expect": {"mode": "off", "stage": 0, "stage_kw": 0, "targets": [false, false, false], "write": true, "reason": "Failsafe: ohne frischen Befehl bleibt das Relais aus"}},
    {"name": "ausdrücklich aus", "config": {"ip": "192.168.178.43", "channels": [0, 1, 2], "output_kw": [2.0, 2.0, 2.0], "stages": [1, 2, 3]}, "command": {"on_off": false, "setpoint_kw": 6.0, "control_enabled": true}, "day": 0,
