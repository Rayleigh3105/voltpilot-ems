    {"name": "ein Ausgang ungelesen: Stufe unbekannt, nie aus", "config": {"channels": [0, 1, 2], "output_kw": [2.0, 2.0, 2.0]}, "write": true, "targets": [true, false, false], "read": [true, null, false],
