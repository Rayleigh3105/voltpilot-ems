    {"name": "HZ-4 B: bei zwei Phasen hält der dritte die Summe", "config": {"ip": "192.168.178.43", "channels": [0, 1, 2], "output_kw": [2.0, 2.0, 2.0], "stages": [1, 2, 3]}, "command": {"setpoint_kw": 4.0, "control_enabled": true}, "day": 20394,
     "prev": {"commanded": [true, true, false], "read": [true, true, true]},
     "expect": {"mode": "on", "stage": 2, "stage_kw": 4.0, "targets": [true, false, false], "counted": [false, false, true], "write": true}},
