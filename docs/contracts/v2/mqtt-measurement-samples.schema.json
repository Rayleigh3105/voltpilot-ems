{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voltpilot.de/schemas/mqtt-measurement-samples/2.0",
  "title": "VoltPilot additional measurement sample batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "site_id", "device_id", "catalog_version", "sequence", "observed_at", "samples"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "tenant_id": {"$ref": "#/$defs/uuid"},
    "site_id": {"$ref": "#/$defs/uuid"},
    "device_id": {"$ref": "#/$defs/uuid"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"},
    "sequence": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string", "format": "date-time"},
    "samples": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/sample"}},
    "dropped_samples": {"type": "integer", "minimum": 0},
    "gap": {"type": "boolean"}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "point_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._*\\[\\]@-]{0,239}$"},
    "wire_value": {"type": ["number", "string", "boolean"]},
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_key", "raw", "quality"],
      "properties": {
        "point_key": {"$ref": "#/$defs/point_key"},
        "raw": {"$ref": "#/$defs/wire_value"},
        "decoded": {"$ref": "#/$defs/wire_value"},
        "quality": {"enum": ["good", "uncertain", "invalid", "stale", "device_error"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "signed_data": {"type": "string", "maxLength": 32768},
        "signed_data_format": {"type": "string", "maxLength": 128}
      }
    }
  },
  "x-topic": "ems/{tenant_id}/{site_id}/{device_id}/v2/measurement-samples",
  "x-mqtt": {"qos": 1, "retained": false},
  "x-identity-rule": "The three topic identity segments MUST byte-equal the payload identity fields.",
  "x-honesty-rule": "A sample exists only after a physical/protocol read. raw is the received value; decoded MUST NOT be inverted to manufacture raw."
}
