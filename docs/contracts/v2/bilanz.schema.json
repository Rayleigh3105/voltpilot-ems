{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voltpilot.de/contracts/v2/bilanz.schema.json",
  "title": "Energiebilanz: Bilanz-Rolle, Rest, Summe, Saldo, Ebenen und Herkunft",
  "description": "Der Vertrag der ENERGIEBILANZ eines elektrischen Systems (UEMS AP-10 §4.3–§4.9, Prosa: bilanz.md): wie aus der zeitgültigen STELLUNG einer Messstelle ihre Bilanz-Rolle wird, wie der Rest eines Hauptzählers entsteht, wie Zustand, Abdeckung, Kennzeichen und Version sich fortpflanzen, welche Richtung ein Ergebnis je Formel-Typ trägt und was die Herkunft eines berechneten Werts nennt. Er beschreibt die Vektor-Datei bilanz-vectors.json, gegen die BEIDE Umsetzungen gefahren werden: Java services/api .../uems/BilanzAbleitung und TypeScript frontend/portal/src/uemsBilanz.ts. Der Formel-Vertrag der gewichteten Summe (messstelle-formel.md, PR #688) bleibt unberührt und wird AUFGERUFEN, nie nachgebaut.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "herkunft",
    "zeitzone",
    "referenzunternehmen",
    "vokabulare",
    "zustand_rang",
    "kennzeichen_erbend",
    "richtung_je_typ",
    "regeln",
    "saetze",
    "verbotene_woerter",
    "zwillinge",
    "cases"
  ],
  "properties": {
    "_comment": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Die Regel in Prosa — dieselbe wie in der .md-Datei."
    },
    "schema_version": {
      "type": "string",
      "const": "1.1",
      "description": "Fassung dieses Vertrags. Bleibt; Erweiterungen sind additiv."
    },
    "$schema_datei": {
      "type": "string"
    },
    "herkunft": {
      "type": "string",
      "minLength": 1,
      "description": "Konzeptpaket, Regelnummern und Entscheide."
    },
    "zeitzone": {
      "type": "string",
      "const": "Europe/Berlin",
      "description": "Die Zeitzone des Standorts, in der ein Tag um 00:00 beginnt. Ahrenberg liegt in Europe/Berlin; das Feld ist die Zeitzone DIESER Fälle, keine Festlegung für jeden Kunden."
    },
    "referenzunternehmen": {
      "type": "string",
      "const": "./uems-referenzunternehmen.json",
      "description": "Die EINE Beispielwelt."
    },
    "referenz_stand": {
      "type": "string"
    },
    "titel": {
      "type": "string"
    },
    "regeln_kurz": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Die Kurzfassung der Regeln aus AP-10."
    },
    "plan_abnahmen": {
      "type": "object",
      "description": "Die Plan-Abnahme des Programms und der Fall, der sie trägt."
    },
    "vokabulare": {
      "type": "object",
      "description": "Die geschlossenen Wortlisten dieses Vertrags."
    },
    "regeln": {
      "type": "object",
      "description": "Die Schwellen und Formate, die BEIDE Zwillinge lesen."
    },
    "saetze": {
      "type": "object",
      "description": "Die Kundensätze als Vorlagen mit Platzhaltern."
    },
    "zwillinge": {
      "type": "object",
      "description": "Je Regel: WER sie prüft (java · ts).",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "java",
            "ts"
          ]
        }
      }
    },
    "zwillinge_grund": {
      "type": "object",
      "description": "Je Regel ohne TS-Zwilling: der Grund. Ohne Grund keine Lücke.",
      "additionalProperties": {
        "type": "string",
        "minLength": 20
      }
    },
    "_abweichungen": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/abweichung"
      }
    },
    "_nicht_geprueft": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nicht_geprueft"
      }
    },
    "zustand_rang": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "vollständig",
          "unvollständig",
          "keine Werte",
          "mit Ersatzwert"
        ]
      },
      "minItems": 1,
      "description": "Von gut nach schlecht: der „schlechteste Eingang“ ist der letzte dieser Liste, der vorkommt."
    },
    "kennzeichen_erbend": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "muster",
          "als",
          "warum"
        ],
        "properties": {
          "muster": {
            "type": "string"
          },
          "als": {
            "type": "string"
          },
          "warum": {
            "type": "string",
            "minLength": 20
          }
        }
      },
      "minItems": 1,
      "description": "Was ein berechneter Wert von einem Eingang ERBT — alles andere bleibt am Eingang und ist nur in der Herkunft sichtbar."
    },
    "richtung_je_typ": {
      "type": "object",
      "description": "E1: die Ergebnis-Richtung ist je Formel-Typ eine REGEL, keine Ableitung aus Vorzeichen."
    },
    "verbotene_woerter": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Wörter, die eine URSACHE behaupten. Eine Differenz ist eine Differenz; keine Fläche und kein Kundensatz dieses Vertrags darf sie tragen (Grenze des Captains)."
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fall"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "betrag": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "Ein Betrag als DEZIMALTEXT — nie Gleitkomma. Verglichen wird numerisch."
    },
    "tag": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "abweichung": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fall",
        "feld",
        "grund"
      ],
      "properties": {
        "fall": {
          "type": "string"
        },
        "feld": {
          "type": "string"
        },
        "vorlage": {},
        "statt": {},
        "grund": {
          "type": "string",
          "minLength": 20
        }
      },
      "description": "Eine bewusste Abweichung von `referenzfaelle.json` — mit Grund, nie stillschweigend."
    },
    "nicht_geprueft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fall",
        "feld",
        "warum"
      ],
      "properties": {
        "fall": {
          "type": "string"
        },
        "feld": {
          "type": "string"
        },
        "warum": {
          "type": "string",
          "minLength": 20
        }
      },
      "description": "Eine Erwartung der Vorlage, die hier steht, aber (noch) kein Zwilling nachrechnet."
    },
    "pruefung": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regel",
        "name",
        "eingang",
        "ergebnis"
      ],
      "properties": {
        "regel": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "eingang": {},
        "ergebnis": {}
      },
      "description": "Eine Prüfung: ihre Regel, ihr Eingang und das Ergebnis, das beide Zwillinge liefern."
    },
    "fall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "familie",
        "abnahme",
        "titel",
        "why",
        "schritte",
        "pruefungen"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "id": {
          "type": "string",
          "pattern": "^F[0-9]{1,2}$"
        },
        "familie": {
          "type": "string",
          "enum": [
            "gebaeude",
            "korrektur",
            "live",
            "netzanschluss",
            "rechte",
            "rest",
            "saldo",
            "summe",
            "versorgung",
            "verteilung",
            "zeit",
            "zustand"
          ]
        },
        "abnahme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "titel": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "anlage": {
          "type": "string"
        },
        "periode": {
          "type": "string"
        },
        "einheit": {
          "type": "string"
        },
        "schritte": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "pruefungen": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pruefung"
          }
        },
        "beschreibend": {
          "type": "object"
        },
        "annahmen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Ein handgerechneter Referenzfall aus AP-10 §7."
    }
  }
}
