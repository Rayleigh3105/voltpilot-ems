{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voltpilot.local/contracts/v2/kennzahl.schema.json",
  "title": "Kennzahl: Rechenformen, Perioden, Einheiten, Qualität, Zusammenfassung und Geltung — die Vektor-Datei (UEMS AP-11)",
  "description": "Die Form von kennzahl-vectors.json. Die Datei legt fest, wie aus Menge und Bezugsgröße (oder Teil und Ganzem, oder mehreren Kennzahlen) eine Kennzahl mit Zustand, Richtung, Abdeckung, Kennzeichen, Fassung und Version wird — und wann eine Definition abgelehnt wird. Zwei Zwillinge prüfen JEDE Regel, die `zwillinge` ihnen zuschreibt: Java services/api .../uems/KennzahlVectorsTest (KennzahlRegeln) und TypeScript frontend/portal/src/uemsKennzahl.test.ts (uemsKennzahl.ts). Beträge sind Dezimaltext und werden auf `regeln.vergleich_nachkommastellen` verglichen; null heißt „keine Werte“, nie 0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_comment", "schema_version", "$schema_datei", "herkunft", "zeitzone", "referenzunternehmen", "referenz_stand", "titel", "plan_abnahmen", "regeln_kurz", "vokabulare", "zustand_rang", "perioden", "rechte", "regeln", "saetze", "schnittstelle", "verbotene_woerter", "zwillinge", "zwillinge_grund", "_abweichungen", "_nicht_geprueft", "cases"],
  "properties": {
    "_comment": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "schema_version": { "type": "string", "const": "1.0", "description": "Fassung dieser Datei. Erweiterungen sind additiv." },
    "$schema_datei": { "type": "string", "const": "./kennzahl.schema.json" },
    "herkunft": { "type": "string", "minLength": 1 },
    "zeitzone": { "type": "string", "const": "Europe/Berlin", "description": "Die Zeitzone der Beispielwelt; die Regeln nehmen die Zone des Standorts." },
    "referenzunternehmen": { "type": "string", "const": "./uems-referenzunternehmen.json" },
    "referenz_stand": { "type": "string", "const": "1.3", "description": "Die Fassung des Referenzunternehmens, deren Kennzahlen die Regel `referenz` liest." },
    "titel": { "type": "string", "minLength": 1 },
    "plan_abnahmen": {
      "type": "object", "additionalProperties": false, "required": ["gebaeude", "unternehmen"],
      "properties": { "gebaeude": { "type": "string", "minLength": 1 }, "unternehmen": { "type": "string", "minLength": 1 } }
    },
    "regeln_kurz": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "vokabulare": {
      "type": "object", "additionalProperties": false,
      "required": ["rechenform", "rechenform_vorgesehen", "eingang_art", "eingang_art_anfrage", "eingang_rolle", "periode_art", "geltung_art", "zustand", "richtung_unsicherheit", "grund_ohne_zahl", "fehler", "sichtbarkeit", "protokoll", "ereignisse_reserviert", "rechte"],
      "properties": {
        "rechenform": { "$ref": "#/$defs/woerter" },
        "rechenform_vorgesehen": { "$ref": "#/$defs/woerter" },
        "eingang_art": { "$ref": "#/$defs/woerter" },
        "eingang_art_anfrage": { "$ref": "#/$defs/woerter" },
        "eingang_rolle": { "$ref": "#/$defs/woerter" },
        "periode_art": { "$ref": "#/$defs/woerter" },
        "geltung_art": { "$ref": "#/$defs/woerter" },
        "zustand": { "type": "array", "items": { "$ref": "#/$defs/zustand" } },
        "richtung_unsicherheit": { "$ref": "#/$defs/woerter" },
        "grund_ohne_zahl": { "$ref": "#/$defs/woerter" },
        "fehler": { "$ref": "#/$defs/woerter" },
        "sichtbarkeit": { "$ref": "#/$defs/woerter" },
        "protokoll": { "$ref": "#/$defs/woerter" },
        "ereignisse_reserviert": { "$ref": "#/$defs/woerter" },
        "rechte": { "$ref": "#/$defs/woerter" }
      }
    },
    "zustand_rang": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/zustand" }, "description": "Vom besten zum schlechtesten (Q3)." },
    "perioden": {
      "type": "object", "additionalProperties": false, "required": ["ordnung", "aufgehen", "woerter", "monatsnamen"],
      "properties": {
        "ordnung": { "$ref": "#/$defs/woerter" },
        "aufgehen": { "type": "object", "additionalProperties": { "$ref": "#/$defs/woerter" } },
        "woerter": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["werte", "werte_dativ", "wert", "je", "teile", "ende"],
            "properties": {
              "werte": { "type": "string" }, "werte_dativ": { "type": "string" }, "wert": { "type": "string" },
              "je": { "type": "string" }, "teile": { "type": "string" }, "ende": { "type": "string" }
            }
          }
        },
        "monatsnamen": { "type": "array", "minItems": 12, "items": { "type": "string" } }
      }
    },
    "rechte": {
      "type": "object", "additionalProperties": false, "required": ["geltung", "kennung", "ansehen"],
      "properties": {
        "geltung": { "type": "object", "additionalProperties": { "type": "string", "enum": ["standort", "unternehmen"] } },
        "kennung": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$" } },
        "ansehen": { "type": "string", "const": "messwerte.ansehen" }
      }
    },
    "regeln": {
      "type": "object", "additionalProperties": false,
      "required": ["wert_nachkommastellen", "vergleich_nachkommastellen", "anzeige_nachkommastellen", "anteil_faktor", "je", "einheit_trenner", "einzahl", "ohne_zahl", "zahlform"],
      "properties": {
        "wert_nachkommastellen": { "type": "integer", "minimum": 4 },
        "vergleich_nachkommastellen": { "type": "integer", "minimum": 1 },
        "anzeige_nachkommastellen": { "type": "integer", "minimum": 0 },
        "anteil_faktor": { "type": "string", "const": "100" },
        "je": { "type": "string", "const": " je " },
        "einheit_trenner": { "type": "string", "const": "/" },
        "einzahl": { "type": "object", "additionalProperties": { "type": "string" } },
        "ohne_zahl": { "type": "string", "const": "—" },
        "zahlform": { "type": "string", "minLength": 1 }
      }
    },
    "saetze": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "schnittstelle": {
      "type": "object", "additionalProperties": false, "required": ["_comment", "ablehnungen"],
      "properties": {
        "_comment": { "type": "string", "minLength": 1 },
        "ablehnungen": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["code", "status", "quelle", "satz", "fakten"],
            "properties": {
              "code": { "type": "string", "pattern": "^[a-z_]+$" },
              "status": { "type": "integer", "enum": [400, 403, 404, 409, 422] },
              "quelle": { "type": "string", "enum": ["schnittstelle", "regel", "rechte"] },
              "satz": { "type": ["string", "null"], "minLength": 1 },
              "fakten": { "type": "array", "items": { "type": "string", "pattern": "^[a-z_]+$" } }
            }
          }
        }
      }
    },
    "verbotene_woerter": { "$ref": "#/$defs/woerter" },
    "zwillinge": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "enum": ["java", "ts"] } } },
    "zwillinge_grund": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "_abweichungen": { "type": "array", "items": { "$ref": "#/$defs/abweichung" } },
    "_nicht_geprueft": { "type": "array", "items": { "$ref": "#/$defs/nicht_geprueft" } },
    "cases": { "type": "array", "minItems": 22, "items": { "$ref": "#/$defs/fall" } }
  },
  "$defs": {
    "woerter": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "zustand": { "type": "string", "enum": ["vollständig", "unvollständig", "keine Werte", "mit Ersatzwert"] },
    "abweichung": {
      "type": "object", "additionalProperties": false, "required": ["fall", "feld", "vorlage", "vertrag", "grund"],
      "properties": {
        "fall": { "type": "string", "minLength": 1 }, "feld": { "type": "string", "minLength": 1 },
        "vorlage": { "type": "string", "minLength": 1 }, "vertrag": { "type": "string", "minLength": 1 },
        "grund": { "type": "string", "minLength": 1 }
      }
    },
    "nicht_geprueft": {
      "type": "object", "additionalProperties": false, "required": ["fall", "was", "warum"],
      "properties": { "fall": { "type": "string", "minLength": 1 }, "was": { "type": "string", "minLength": 1 }, "warum": { "type": "string", "minLength": 1 } }
    },
    "fall": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "familie", "abnahme", "titel", "why", "schritte", "pruefungen"],
      "properties": {
        "id": { "type": "string", "pattern": "^K[0-9]+$" },
        "name": { "type": "string", "pattern": "^k[0-9]+-[a-z0-9-]+$" },
        "familie": { "type": "string", "enum": ["plan_abnahme", "bestand", "kaskade", "qualitaet", "periode", "form", "definition", "rechte", "vorlage"] },
        "abnahme": { "type": ["string", "null"], "enum": ["gebaeude", "unternehmen", null] },
        "titel": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "schritte": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "pruefungen": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pruefung" } }
      }
    },
    "pruefung": {
      "type": "object", "additionalProperties": false, "required": ["regel", "name", "eingang", "ergebnis"],
      "properties": {
        "regel": { "type": "string", "enum": ["wert", "einheit", "periode", "bestehen", "laufend", "stichtag", "zyklus", "fassung", "fassung_am", "geltung", "eingang_geltung", "rechte", "vorlage", "kopie", "herkunft", "referenz", "kennzeichen", "rechenform", "satz"] },
        "name": { "type": "string", "minLength": 1 },
        "eingang": { "type": "object" },
        "ergebnis": { "type": "object" }
      }
    }
  }
}
