{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voltpilot.de/schemas/measurements-raw-event/1.0",
  "title": "Validated measurements.raw event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "tenant_id", "site_id", "device_id", "catalog_version", "sequence", "observed_at", "ingested_at", "source_topic", "samples"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "site_id": {"type": "string", "format": "uuid"},
    "device_id": {"type": "string", "format": "uuid"},
    "catalog_version": {"type": "string"},
    "sequence": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string", "format": "date-time"},
    "ingested_at": {"type": "string", "format": "date-time"},
    "source_topic": {"type": "string"},
    "samples": {"type": "array", "minItems": 1, "maxItems": 256},
    "dropped_samples": {"type": "integer", "minimum": 0},
    "gap": {"type": "boolean"}
  }
}
