    "fall_fassung": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "familie", "fall", "why", "eingang", "erwartet"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "familie": { "const": "fassung" },
        "fall": { "type": "string", "minLength": 1 },
