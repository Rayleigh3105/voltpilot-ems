          "properties": {
            "summe_der_angezeigten": { "type": "string", "minLength": 1 },
            "differenz": { "type": ["string", "null"] },
            "satz": { "type": ["string", "null"] }
          }
        }
      }
    },
    "fall_herkunft": {
      "type": "object",
