        },
        "erwartet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "unbekannt"],
          "properties": {
            "text": { "type": ["string", "null"], "description": "Der gesprochene Satz; null = nichts gesprochen." },
            "unbekannt": { "type": "boolean", "description": "true = ein fremder Wert, der nicht gesprochen wird (Fehler)." }
          }
        }
      }
    },
    "fall_grund": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "familie",
        "fall",
        "why",
        "eingang",
        "erwartet"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "familie": {
          "const": "grund"
        },
        "fall": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "eingang": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "werte"
          ],
          "properties": {
            "code": {
              "type": [
                "string",
                "null"
              ],
              "description": "Das Feld grund der Route, wie geliefert."
            },
            "werte": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Die Platzhalter, aus den Feldern der Antwort gebildet."
            }
          }
        },
        "erwartet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "fehler"
          ],
          "properties": {
            "text": {
              "type": [
                "string",
                "null"
              ],
              "description": "Der gesprochene Satz; null = nichts gesprochen."
            },
            "fehler": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "grund_unbekannt",
                "platzhalter_falsch"
              ],
              "description": "null = gesprochen; sonst ein Programmfehler des Aufrufers."
            }
          }
        }
      }
    }
  }
