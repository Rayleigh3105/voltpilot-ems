    "fall_tagesdauer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "familie", "fall", "why", "eingang", "erwartet"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "familie": { "const": "tagesdauer" },
        "fall": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "eingang": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "zeitzone"],
          "properties": { "tag": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }, "zeitzone": { "type": "string", "minLength": 1 } }
        },
        "erwartet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stunden", "satz"],
          "properties": { "stunden": { "type": "integer", "minimum": 23, "maximum": 25 }, "satz": { "type": ["string", "null"] } }
        }
      }
    },
    "fall_raster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "familie", "fall", "why", "eingang", "erwartet"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "familie": { "const": "raster" },
        "fall": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "ausschnitt_ab": { "type": "integer", "minimum": 0, "description": "Die Felder stehen ab diesem Index; ohne Angabe ist die Liste vollständig." },
        "eingang": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "zeitzone", "schritt"],
          "properties": {
            "tag": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "zeitzone": { "type": "string", "minLength": 1 },
            "schritt": { "type": "string", "enum": ["viertelstunde", "stunde"] }
          }
        },
        "erwartet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["anzahl", "felder"],
          "properties": {
            "anzahl": { "type": "integer", "minimum": 1 },
            "felder": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["beschriftung", "von"],
                "properties": {
                  "beschriftung": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]–[0-2][0-9]:[0-5][0-9]( (MEZ|MESZ|UTC[+-][0-9]{2}:[0-9]{2}))?$" },
                  "von": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$" }
                }
              }
            }
          }
        }
      }
    },
    "fall_rundungsdifferenz": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "familie", "fall", "why", "eingang", "erwartet"],
