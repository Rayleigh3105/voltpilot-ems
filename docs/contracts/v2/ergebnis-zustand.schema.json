        "name": { "type": "string", "minLength": 1 },
        "familie": { "const": "ergebnis" },
        "fall": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "eingang": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wert", "einheit", "ebene", "zustand", "abdeckung_prozent", "kennzeichen"],
          "properties": {
            "wert": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/dezimaltext" }] },
            "einheit": { "type": "string", "minLength": 1 },
            "ebene": { "type": ["string", "null"] },
            "zustand": { "type": "string", "minLength": 1 },
            "abdeckung_prozent": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/dezimaltext" }] },
            "kennzeichen": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "erwartet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verstoesse", "satz"],
          "properties": {
