{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voltpilot.local/contracts/v2/events-raw.event.schema.json",
  "title": "VoltPilot Redpanda events.raw Event",
  "description": "EIN Ereignis auf dem Redpanda-Topic `events.raw` (UEMS AP-07 IP-3, Entscheid E11: EIN Ereignis-Vertrag für beide Pfade, nie gelöscht). Zwei Wege führen hinein: die Datenannahme zerlegt einen geprüften mqtt-events-2.1-Umschlag in ein Ereignis je Eintrag (Urheber box; `box` = device_id aus dem Topic), und die Cloud-Dienste schreiben ihre eigenen Ereignisse (Urheber datenannahme, writer, cloud, kunde). Der Speicher (IP-8) hängt jedes Ereignis an, nie wird eines geändert oder gelöscht; eine Fortschreibung trägt dieselbe ereignis_id. Ein neuer Ereignis-Vertrag, deshalb beginnt schema_version bei 1.0.",
  "type": "object",
  "x-kafka": {
    "topic": "events.raw",
    "key": "{tenant_id}:{site_id}",
    "partitioning": "je Kundenbereich und Anlage, damit die Ereignisse einer Anlage geordnet bleiben"
  },
  "required": [
    "schema_version",
    "event_id",
    "tenant_id",
    "site_id",
    "urheber",
    "ingested_at",
    "ereignis"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_id": {
      "$ref": "#/$defs/uuid",
      "description": "Kennung dieses Datensatzes (Nachverfolgung). Die Identität des Ereignisses ist ereignis.ereignis_id."
    },
    "tenant_id": {
      "$ref": "#/$defs/uuid"
    },
    "site_id": {
      "$ref": "#/$defs/uuid"
    },
    "urheber": {
      "$ref": "#/$defs/urheber"
    },
    "ingested_at": {
      "$ref": "#/$defs/zeit_utc",
      "description": "Eingangszeit: wann die Datenannahme den Umschlag annahm bzw. der Cloud-Dienst das Ereignis schrieb."
    },
    "device_id": {
      "$ref": "#/$defs/uuid",
      "description": "Die Box des Umschlags (nur Urheber box, dort Pflicht)."
    },
    "source_topic": {
      "type": "string",
      "minLength": 1,
      "description": "Das MQTT-Topic des Umschlags (nur Urheber box, dort Pflicht)."
    },
    "sequence": {
      "$ref": "#/$defs/ganz_ab_0",
      "description": "Die Sequenz des Umschlags (nur Urheber box, dort Pflicht)."
    },
    "observed_at": {
      "$ref": "#/$defs/zeit_utc",
      "description": "observed_at des Umschlags (nur Urheber box, dort Pflicht)."
    },
    "ereignis": {
      "$ref": "#/$defs/ereignis"
    }
  },
  "anyOf": [
    {
      "description": "Weg 1: aus einem Box-Umschlag.",
      "required": [
        "device_id",
        "source_topic",
        "sequence",
        "observed_at"
      ],
      "properties": {
        "urheber": {
          "const": "box"
        }
      }
    },
    {
      "description": "Weg 2: von einem Cloud-Dienst oder einem Menschen im Portal.",
      "properties": {
        "urheber": {
          "enum": [
            "datenannahme",
            "writer",
            "cloud",
            "kunde"
          ]
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "zeit_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Ein Zeitpunkt in UTC, auf die Sekunde (E13)."
    },
    "zeit_utc_oder_leer": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Ein Zeitpunkt in UTC, oder null für „offen“ bzw. „nie“."
    },
    "kennung": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/′-]*$",
      "description": "Eine Kennung, wie die Cloud sie vergibt (UUID oder Kennzeichen wie E-2′, DQ-4, K-8.1, MS-06, Z-5a)."
    },
    "messkanal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "description": "Der Messkanal der Reihe (Katalog-Schlüssel oder Kern-Kanal)."
    },
    "einheit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "einheit_zuwachs": {
      "type": "string",
      "enum": [
        "Wh",
        "kWh",
        "MWh",
        "varh",
        "kvarh",
        "m³"
      ],
      "description": "Die Einheit des Zuwachses über eine Lücke (AP-08 IP-6): die Zählerstand-Einheiten des Größen-Katalogs der Messstellen mit ihren umrechenbaren Einheiten — vokabular.einheit_zuwachs."
    },
    "ganz_ab_0": {
      "type": "integer",
      "minimum": 0
    },
    "ganz_ab_1": {
      "type": "integer",
      "minimum": 1
    },
    "sekunden": {
      "type": "integer",
      "description": "Eine Dauer in Sekunden."
    },
    "statuswort": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "stand": {
      "type": "number",
      "description": "Ein Zählerstand in der Einheit des Ereignisses."
    },
    "ganz_liste": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "rohwert": {
      "type": [
        "number",
        "string",
        "boolean"
      ]
    },
    "messwert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "decoded",
        "qualitaet"
      ],
      "properties": {
        "raw": {
          "$ref": "#/$defs/rohwert"
        },
        "decoded": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ],
          "description": "null, wenn der Kanal keinen decodierten Wert liefert (measurement-samples 2.1 lässt decoded weg) — nie weggelassen, nie 0."
        },
        "qualitaet": {
          "$ref": "#/$defs/qualitaet"
        }
      }
    },
    "wert": {
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },
    "qualitaet": {
      "type": "string",
      "enum": [
        "good",
        "uncertain",
        "invalid",
        "stale",
        "device_error"
      ]
    },
    "strom": {
      "type": "string",
      "enum": [
        "telemetry",
        "measurement-samples",
        "events"
      ],
      "description": "Der Uplink der Box — das Blatt des Topics unter …/v2/."
    },
    "erkannt_aus": {
      "type": "string",
      "enum": [
        "kadenz",
        "verdraengung",
        "herzschlag"
      ]
    },
    "fehlerklasse": {
      "type": "string",
      "enum": [
        "unreachable",
        "no_answer",
        "invalid_response",
        "implausible",
        "fronius_api",
        "timeout",
        "layout_changed",
        "budget",
        "box_meldet_sich_nicht"
      ],
      "description": "Die Fehlerklassen je Quelle aus data-source-vectors.json (AP-06 E5)."
    },
    "grund": {
      "type": "string",
      "enum": [
        "herkunft_unvollstaendig",
        "fassung_unbekannt",
        "kennung_abweichend",
        "schema_verletzt",
        "wort_unbekannt",
        "urheber_unzulaessig",
        "zeit_ungueltig",
        "regel_verletzt",
        "fortschreibung_unzulaessig"
      ],
      "description": "Der Ablehnungsgrund — geschlossen; ein anderes Wort wird verworfen."
    },
    "anlass_geraetegrenze": {
      "type": "string",
      "enum": [
        "zaehlerwechsel",
        "kartenwechsel",
        "controllerwechsel",
        "zaehler_zurueckgesetzt"
      ]
    },
    "anlass_uebergabe": {
      "type": "string",
      "enum": [
        "uebergabe",
        "box_tausch"
      ]
    },
    "ersatzwert_methode": {
      "type": "string",
      "enum": [
        "gleichmaessig_verteilen",
        "profil_vorperiode",
        "profil_vergleichsquelle",
        "ablesestand_nachtragen",
        "wert_eingeben",
        "vorperiode_uebernehmen",
        "vergleichsquelle_uebernehmen"
      ],
      "description": "Die sieben Methoden eines Ersatzwerts (AP-08 E7) — vokabular.ersatzwert_methode."
    },
    "ersatzwert_status": {
      "type": "string",
      "enum": [
        "wirksam",
        "zurueckgenommen"
      ]
    },
    "korrektur_art": {
      "type": "string",
      "enum": [
        "nachlieferung_nach_endgueltigkeit",
        "ablesestaende_nachgetragen",
        "umklassifizierung",
        "ersatzwert",
        "wert_berichtigt"
      ]
    },
    "korrektur_status": {
      "type": "string",
      "enum": [
        "vorschlag",
        "freigegeben",
        "abgelehnt",
        "zurueckgenommen"
      ]
    },
    "urheber": {
      "type": "string",
      "enum": [
        "box",
        "datenannahme",
        "writer",
        "cloud",
        "kunde"
      ]
    },
    "ereignis": {
      "description": "EIN Ereignis — genau eine Art aus dem geschlossenen Vokabular (events-vocabulary-vectors.json).",
      "anyOf": [
        {
          "$ref": "#/$defs/art_data_gap"
        },
        {
          "$ref": "#/$defs/art_backfill"
        },
        {
          "$ref": "#/$defs/art_duplicate_conflict"
        },
        {
          "$ref": "#/$defs/art_sequence_gap"
        },
        {
          "$ref": "#/$defs/art_sequence_reset"
        },
        {
          "$ref": "#/$defs/art_late_arrival"
        },
        {
          "$ref": "#/$defs/art_counter_reset"
        },
        {
          "$ref": "#/$defs/art_counter_overflow"
        },
        {
          "$ref": "#/$defs/art_device_boundary"
        },
        {
          "$ref": "#/$defs/art_handover"
        },
        {
          "$ref": "#/$defs/art_unassigned_reader"
        },
        {
          "$ref": "#/$defs/art_rejected"
        },
        {
          "$ref": "#/$defs/art_clock_ahead"
        },
        {
          "$ref": "#/$defs/art_too_old"
        },
        {
          "$ref": "#/$defs/art_clock_jump"
        },
        {
          "$ref": "#/$defs/art_box_restart"
        },
        {
          "$ref": "#/$defs/art_device_restart"
        },
        {
          "$ref": "#/$defs/art_frozen_source"
        },
        {
          "$ref": "#/$defs/art_range_limit"
        },
        {
          "$ref": "#/$defs/art_layout_changed"
        },
        {
          "$ref": "#/$defs/art_error_change"
        },
        {
          "$ref": "#/$defs/art_state_change"
        },
        {
          "$ref": "#/$defs/art_bitfield_change"
        },
        {
          "$ref": "#/$defs/art_text_change"
        },
        {
          "$ref": "#/$defs/art_substitute"
        },
        {
          "$ref": "#/$defs/art_correction"
        },
        {
          "$ref": "#/$defs/art_verteilung_geaendert"
        },
        {
          "$ref": "#/$defs/art_bilanz_neu_berechnet"
        }
      ]
    },
    "art_data_gap": {
      "type": "object",
      "description": "data_gap — Lücke. Urheber: writer, box, cloud.",
      "additionalProperties": false,
      "required": [
        "ereignis_id",
        "art",
        "von",
        "bis",
        "box",
        "erkannt_aus"
      ],
      "properties": {
        "ereignis_id": {
          "$ref": "#/$defs/uuid"
        },
        "art": {
          "const": "data_gap"
        },
        "von": {
          "$ref": "#/$defs/zeit_utc"
        },
        "bis": {
          "$ref": "#/$defs/zeit_utc_oder_leer"
        },
        "box": {
          "$ref": "#/$defs/kennung"
        },
        "erkannt_aus": {
          "$ref": "#/$defs/erkannt_aus"
        },
        "datenquelle": {
          "$ref": "#/$defs/kennung"
        },
        "komponente": {
          "$ref": "#/$defs/kennung"
        },
        "messkanal": {
          "$ref": "#/$defs/messkanal"
        },
        "messstelle": {
          "$ref": "#/$defs/kennung"
        },
        "erwartet_fehlend": {
          "$ref": "#/$defs/ganz_ab_0"
        },
        "nachgeliefert_am": {
          "$ref": "#/$defs/zeit_utc_oder_leer"
        },
        "fehlerklasse": {
          "$ref": "#/$defs/fehlerklasse"
        },
        "ursache_ereignis": {
          "$ref": "#/$defs/uuid"
        },
        "zuwachs": {
          "$ref": "#/$defs/stand"
        },
        "einheit": {
          "$ref": "#/$defs/einheit_zuwachs"
        },
        "stand_vor": {
          "$ref": "#/$defs/stand"
        },
        "stand_nach": {
          "$ref": "#/$defs/stand"
        }
      }
    },
    "art_backfill": {
      "type": "object",
      "description": "backfill — Nachlieferung. Urheber: writer, cloud.",
      "additionalProperties": false,
      "required": [
        "ereignis_id",
        "art",
        "von",
        "bis",
        "box",
        "datenquelle",
        "eingang_von",
        "eingang_bis",
        "anzahl"
      ],
      "properties": {
