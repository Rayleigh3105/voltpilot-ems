          "$ref": "#/$defs/uuid"
        },
        "art": {
          "const": "backfill"
        },
        "von": {
          "$ref": "#/$defs/zeit_utc"
        },
        "bis": {
          "$ref": "#/$defs/zeit_utc"
        },
        "box": {
          "$ref": "#/$defs/kennung"
        },
        "datenquelle": {
          "$ref": "#/$defs/kennung"
        },
        "eingang_von": {
          "$ref": "#/$defs/zeit_utc"
        },
        "eingang_bis": {
          "$ref": "#/$defs/zeit_utc"
        },
        "anzahl": {
          "$ref": "#/$defs/ganz_ab_1"
        },
        "erwartet": {
          "$ref": "#/$defs/ganz_ab_1"
        }
      }
    },
    "art_duplicate_conflict": {
      "type": "object",
      "description": "duplicate_conflict — Abweichender Wert. Urheber: writer.",
      "additionalProperties": false,
      "required": [
        "ereignis_id",
        "art",
        "zeitpunkt",
        "box",
        "komponente",
        "messkanal",
        "messzeit",
        "gespeicherter_wert",
        "abgewiesener_wert",
        "sequenzen"
      ],
      "properties": {
        "ereignis_id": {
          "$ref": "#/$defs/uuid"
        },
        "art": {
          "const": "duplicate_conflict"
        },
        "zeitpunkt": {
          "$ref": "#/$defs/zeit_utc"
        },
        "box": {
          "$ref": "#/$defs/kennung"
        },
        "komponente": {
          "$ref": "#/$defs/kennung"
        },
        "messkanal": {
