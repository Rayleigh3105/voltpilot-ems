        },
        "zeitpunkt": {
          "$ref": "#/$defs/zeit_utc"
        },
        "box": {
          "$ref": "#/$defs/kennung"
        },
        "strom": {
          "$ref": "#/$defs/strom"
        },
        "sequenz_erwartet": {
          "$ref": "#/$defs/ganz_ab_0"
        },
        "sequenz_erhalten": {
          "$ref": "#/$defs/ganz_ab_0"
        },
        "anzahl": {
          "$ref": "#/$defs/ganz_ab_1"
        }
      }
    },
    "art_sequence_reset": {
      "type": "object",
      "description": "sequence_reset — Paketzählung neu begonnen. Urheber: writer.",
      "additionalProperties": false,
      "required": [
        "ereignis_id",
        "art",
        "zeitpunkt",
        "box",
        "strom",
        "sequenz_erwartet",
        "sequenz_erhalten"
      ],
      "properties": {
        "ereignis_id": {
          "$ref": "#/$defs/uuid"
        },
        "art": {
          "const": "sequence_reset"
        },
        "zeitpunkt": {
          "$ref": "#/$defs/zeit_utc"
        },
        "box": {
          "$ref": "#/$defs/kennung"
        },
        "strom": {
          "$ref": "#/$defs/strom"
        },
        "sequenz_erwartet": {
          "$ref": "#/$defs/ganz_ab_0"
        },
        "sequenz_erhalten": {
