        "art",
        "zeitpunkt",
        "box",
        "strom",
        "sequenz_erwartet",
        "sequenz_erhalten",
        "anzahl"
      ],
      "properties": {
        "ereignis_id": {
          "$ref": "#/$defs/uuid"
        },
        "art": {
