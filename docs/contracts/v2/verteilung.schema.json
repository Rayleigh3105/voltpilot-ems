{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voltpilot.de/contracts/v2/verteilung.schema.json",
  "title": "Feste Verteilung einer Messstelle auf Kostenstellen",
  "description": "Der Vertrag der FESTEN VERTEILUNG (UEMS AP-10 §4.6, Prosa: verteilung.md): eine zeitgültige Beziehung Messstelle → Kostenstelle mit Anteil, deren Zeilen sich an jedem Tag auf genau 100 % summieren; sie wirkt je Tag auf die Tagesmenge, endet mit ihrem Ziel und kennt keine dynamischen Schlüssel. Er beschreibt verteilung-vectors.json, gegen die Java services/api .../uems/VerteilungRegeln und TypeScript frontend/portal/src/uemsVerteilung.ts gefahren werden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "herkunft",
    "zeitzone",
    "referenzunternehmen",
    "vokabulare",
    "regeln",
    "saetze",
    "zwillinge",
    "cases"
  ],
  "properties": {
    "_comment": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Die Regel in Prosa — dieselbe wie in der .md-Datei."
    },
    "schema_version": {
      "type": "string",
      "const": "1.3",
      "description": "Fassung dieses Vertrags. Bleibt; Erweiterungen sind additiv."
    },
    "$schema_datei": {
      "type": "string"
    },
    "herkunft": {
      "type": "string",
      "minLength": 1,
      "description": "Konzeptpaket, Regelnummern und Entscheide."
    },
    "zeitzone": {
      "type": "string",
      "const": "Europe/Berlin",
      "description": "Die Zeitzone des Standorts, in der ein Tag um 00:00 beginnt. Ahrenberg liegt in Europe/Berlin; das Feld ist die Zeitzone DIESER Fälle, keine Festlegung für jeden Kunden."
    },
    "referenzunternehmen": {
      "type": "string",
      "const": "./uems-referenzunternehmen.json",
      "description": "Die EINE Beispielwelt."
    },
    "referenz_stand": {
      "type": "string"
    },
    "titel": {
      "type": "string"
    },
    "regeln_kurz": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Die Kurzfassung der Regeln aus AP-10."
    },
    "plan_abnahmen": {
      "type": "object",
      "description": "Die Plan-Abnahme des Programms und der Fall, der sie trägt."
    },
    "vokabulare": {
      "type": "object",
      "description": "Die geschlossenen Wortlisten dieses Vertrags."
    },
    "regeln": {
      "type": "object",
      "description": "Die Schwellen und Formate, die BEIDE Zwillinge lesen."
    },
    "saetze": {
      "type": "object",
      "description": "Die Kundensätze als Vorlagen mit Platzhaltern."
    },
    "zwillinge": {
      "type": "object",
      "description": "Je Regel: WER sie prüft (java · ts).",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "java",
            "ts"
          ]
        }
      }
    },
    "zwillinge_grund": {
      "type": "object",
      "description": "Je Regel ohne TS-Zwilling: der Grund. Ohne Grund keine Lücke.",
      "additionalProperties": {
        "type": "string",
        "minLength": 20
      }
    },
    "leseweg": {
      "type": "object",
      "description": "AP-10 IP-5: der EINE Leseweg für den Anteil eines Formel-Terms und die geschlossene Menge seiner benannten Ablehnungen (Code, Status, Kundensatz, worauf sie wartet). Optional — ein Stand vor IP-5 hat den Block nicht.",
      "additionalProperties": false,
      "required": [
        "herkunft",
        "regel",
        "stelle",
        "grund_im_wert",
        "pruefreihenfolge",
        "ablehnungen",
        "zwillinge",
        "zwillinge_grund",
        "faelle"
      ],
      "properties": {
        "herkunft": {
          "type": "string",
          "minLength": 1
        },
        "regel": {
          "type": "string",
          "minLength": 1
        },
        "stelle": {
          "type": "string",
          "minLength": 1,
          "description": "Wo die Entscheidung steht und was ein späteres Paket dort ändert."
        },
        "grund_im_wert": {
          "type": "string",
          "const": "fehlende[].grund",
          "description": "Wo Wert und Verlauf den Code eines nicht lesbaren Terms nennen."
        },
        "pruefreihenfolge": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "ablehnungen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "status",
              "wartet_auf",
              "feld",
              "satz"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "status": {
                "type": "integer",
                "enum": [
                  400,
                  422
                ]
              },
              "wartet_auf": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^AP-[0-9]{2} IP-[0-9]+$",
                "description": "Das Bau-Paket, das die fehlende Fähigkeit liefert; null = eine Vertragsregel, die nie wartet."
              },
              "feld": {
                "type": "string",
                "minLength": 1
              },
              "satz": {
                "type": "string",
                "minLength": 20,
                "description": "Der Kundensatz — die EINE Formulierung."
              }
            }
          }
        },
        "zwillinge": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "java",
              "ts"
            ]
          }
        },
        "zwillinge_grund": {
          "type": "string",
          "minLength": 20
        },
        "faelle": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "fall",
              "term",
              "tag",
              "ergebnis"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "fall": {
                "type": "string",
                "pattern": "^F[0-9]+$"
              },
              "term": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "art",
                  "verteilung_ziel",
                  "quell_messstelle",
                  "anteil",
                  "faktor",
                  "vorzeichen"
                ],
                "properties": {
                  "art": {
                    "type": "string",
                    "enum": [
                      "messkanal",
                      "messstelle",
                      "verteilung"
                    ]
                  },
                  "verteilung_ziel": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "quell_messstelle": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "anteil": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "gesamt",
                      "positiv",
                      "negativ",
                      null
                    ]
                  },
                  "faktor": {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                  },
                  "vorzeichen": {
                    "type": "string",
                    "enum": [
                      "+",
                      "-"
                    ]
                  }
                }
              },
              "tag": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "ergebnis": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ablehnung",
                  "lesung"
                ],
                "properties": {
                  "ablehnung": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "lesung": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "ganz",
                      "tagesanteil",
                      null
                    ],
                    "description": "Wie der Term liest, wenn er nicht abgelehnt wird: der ganze Wert oder der Anteil des Tages aus der Verteilung (AP-10 IP-8); null bei einer Ablehnung."
                  }
                }
              }
            }
          }
        }
      }
    },
    "_abweichungen": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/abweichung"
      }
    },
    "_nicht_geprueft": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nicht_geprueft"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fall"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "betrag": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "Ein Betrag als DEZIMALTEXT — nie Gleitkomma. Verglichen wird numerisch."
    },
    "tag": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "abweichung": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fall",
        "feld",
        "grund"
      ],
      "properties": {
        "fall": {
          "type": "string"
        },
        "feld": {
          "type": "string"
        },
        "vorlage": {},
        "statt": {},
        "grund": {
          "type": "string",
          "minLength": 20
        }
      },
      "description": "Eine bewusste Abweichung von `referenzfaelle.json` — mit Grund, nie stillschweigend."
    },
    "nicht_geprueft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fall",
        "feld",
        "warum"
      ],
      "properties": {
        "fall": {
          "type": "string"
        },
        "feld": {
          "type": "string"
        },
        "warum": {
          "type": "string",
          "minLength": 20
        }
      },
      "description": "Eine Erwartung der Vorlage, die hier steht, aber (noch) kein Zwilling nachrechnet."
    },
    "pruefung": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regel",
        "name",
        "eingang",
        "ergebnis"
      ],
      "properties": {
        "regel": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "eingang": {},
        "ergebnis": {}
      },
      "description": "Eine Prüfung: ihre Regel, ihr Eingang und das Ergebnis, das beide Zwillinge liefern."
    },
    "fall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "familie",
        "abnahme",
        "titel",
        "why",
        "schritte",
        "pruefungen"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "id": {
          "type": "string",
          "pattern": "^F[0-9]{1,2}$"
        },
        "familie": {
          "type": "string",
          "enum": [
            "gebaeude",
            "korrektur",
            "live",
            "netzanschluss",
            "rechte",
            "rest",
            "saldo",
            "summe",
            "versorgung",
            "verteilung",
            "zeit",
            "zustand"
          ]
        },
        "abnahme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "titel": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "anlage": {
          "type": "string"
        },
        "periode": {
          "type": "string"
        },
        "einheit": {
          "type": "string"
        },
        "schritte": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "pruefungen": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pruefung"
          }
        },
        "beschreibend": {
          "type": "object"
        },
        "annahmen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Ein handgerechneter Referenzfall aus AP-10 §7."
    }
  }
}
