{
  "schema_version": "1.0",
  "flow_id": "7d2e9f30-5ba1-4c34-9d56-789abcdef012",
  "flow_version": 1,
  "name": "Heizstab in zwei Zeitfenstern",
  "description": "Zwei Zeitfenster über den Und-Baustein: BEIDE Zweige stammen aus vp.schedule.window und tragen KEINEN msg.topic - der Fall, in dem der Kombinator ohne Compile-Zeit-Diskriminator nicht nur ungenau, sondern falsch rechnete (H3-b).",
  "runtime": "edge",
  "site_id": "00000000-0000-0000-0000-000000000002",
  "tenant_id": "00000000-0000-0000-0000-000000000001",
  "lifecycle": "draft",
  "nodes": [
    {
      "id": "zeit1",
      "type": "vp.schedule.window",
      "type_version": "1.0.0",
      "label": "Morgens",
      "parameters": { "from": "06:00", "to": "08:00", "days": "alle" }
    },
    {
      "id": "zeit2",
      "type": "vp.schedule.window",
      "type_version": "1.0.0",
      "label": "Abends",
      "parameters": { "from": "18:00", "to": "20:00", "days": "alle" }
    },
    {
      "id": "und1",
      "type": "vp.logic.and",
      "type_version": "1.0.0",
      "label": "Beides"
    },
    {
      "id": "steuern1",
      "type": "vp.entity.control",
      "type_version": "1.0.0",
      "label": "Heizstab schalten",
      "parameters": { "entity_id": "heatrod-cellar", "command": "on_off", "ttl_s": 300 },
      "claims": [
        { "entity_id": "heatrod-cellar", "commands": ["on_off"] }
      ]
    }
  ],
  "edges": [
    { "id": "e1", "from": { "node": "zeit1", "port": "active" }, "to": { "node": "und1", "port": "a" } },
    { "id": "e2", "from": { "node": "zeit2", "port": "active" }, "to": { "node": "und1", "port": "b" } },
    { "id": "e3", "from": { "node": "und1", "port": "result" }, "to": { "node": "steuern1", "port": "value" } }
  ],
  "triggers": [
    { "id": "t1", "kind": "slot-boundary" }
  ]
}
