{
  "schema_version": "1.0",
  "flow_id": "7d2f1a9c-3b45-4e67-89ab-cdef01234567",
  "flow_version": 3,
  "name": "Verbraucherregel: Wallbox",
  "description": "GENERIERT vom Consumer-Policy-Compiler (D-19, Verbrauchssteuerung §13.2): die reaktive Pflichtregel »Laden wenn Fahrzeug verbunden« plus eine ODER-Mischung mit einem in der Cloud vorberechneten Preisfenster (D1). Der Override stammt AUSSCHLIESSLICH aus enforcement=must_run; der Server stempelt den origin-Marker - Kundendokumente mit origin werden von der Speicher-API abgewiesen.",
  "runtime": "edge",
  "site_id": "00000000-0000-0000-0000-000000000002",
  "tenant_id": "00000000-0000-0000-0000-000000000001",
  "lifecycle": "active",
  "origin": {
    "kind": "consumer-policy",
    "policy_id": "b58a3c21-7e90-4d12-a345-6789abcdef02",
    "policy_version": 3,
    "entity_id": "wallbox-1"
  },
  "nodes": [
    {
      "id": "reaktiv",
      "type": "vp.consumer.reactive",
      "type_version": "1.0.0",
      "label": "Wallbox: reaktive Regeln",
      "parameters": {
        "entity_id": "wallbox-1",
        "command": "setpoint_kw",
        "ttl_s": 45,
        "renew_s": 15,
        "off_delay_s": 15,
        "requirements": [
          {
            "id": "charge-when-connected",
            "must_run": true,
            "value": 11.0,
            "condition": {
              "signal": "consumer.vehicle_connected",
              "source": "entity",
              "channel": "vehicle_connected",
              "op": "eq",
              "value": 1,
              "max_age_s": 20
            }
          },
          {
            "id": "cheap-or-full",
            "must_run": false,
            "value": 4.2,
            "condition": {
              "any": [
                {
                  "windows": [
                    ["2026-08-10T10:00:00Z", "2026-08-10T14:15:00Z"],
                    ["2026-08-11T09:30:00Z", "2026-08-11T13:00:00Z"]
                  ]
                },
                {
                  "signal": "storage.soc_pct",
                  "source": "site",
                  "channel": "soc_pct",
                  "op": "gt",
                  "value": 80,
                  "reset_value": 75,
                  "max_age_s": 120
                }
              ]
            }
          }
        ]
      },
      "claims": [
        { "entity_id": "wallbox-1", "commands": ["setpoint_kw"] }
      ]
    }
  ],
  "edges": [],
  "triggers": [
    { "id": "tick", "kind": "interval", "every_s": 15 }
  ]
}
