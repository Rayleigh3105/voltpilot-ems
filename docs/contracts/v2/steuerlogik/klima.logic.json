{
 "logic": 1,
 "name": "Klima Büro",
 "description": "Zur Arbeitszeit kühlt das Gerät auf die Wunschtemperatur. Ist Sonnenstrom übrig, kühlt es etwas tiefer vor. Bei offenem Fenster bleibt es aus.\n",
 "devices": {
  "klima": {
   "entity": "klimageraet-buero",
   "name": "Klimagerät"
  }
 },
 "inputs": {
  "raum": {
   "source": "klimageraet-buero.room_temperature",
   "name": "Büro",
   "max_age": "10 min"
  },
  "fenster": {
   "source": "kontakt-fenster-buero.open",
   "name": "Fenster offen",
   "max_age": "10 min"
  },
  "netz": {
   "source": "site.grid",
   "name": "Netzbezug",
   "max_age": "60 s"
  }
 },
 "settings": {
  "betrieb": {
   "name": "Betrieb",
   "type": "select",
   "default": "auto",
   "editable_by": "customer",
   "options": {
    "auto": "Automatik",
    "nur_sonne": "Nur mit Sonnenstrom",
    "abgeschaltet": "Aus"
   },
   "help": "Automatik kühlt zur Arbeitszeit. Nur mit Sonnenstrom kühlt nur, wenn Sonnenstrom übrig ist."
  },
  "arbeitszeit": {
   "name": "Arbeitszeit",
   "type": "schedule",
   "editable_by": "customer",
   "default": [
    {
     "days": "mon-fri",
     "from": "07:00",
     "to": "18:00"
    }
   ]
  },
  "wunsch": {
   "name": "Wunschtemperatur",
   "default": "25 °C",
   "range": [
    "22 °C",
    "27 °C"
   ],
   "step": "0.5 K",
   "editable_by": "customer"
  },
  "vorkuehlen": {
   "name": "Mit Sonnenstrom tiefer um",
   "default": "1.5 K",
   "range": [
    "0 K",
    "3 K"
   ],
   "step": "0.5 K"
  },
  "ab_kw": {
   "name": "Sonnenstrom übrig ab",
   "default": "1 kW",
   "range": [
    "0.5 kW",
    "5 kW"
   ],
   "step": "0.5 kW"
  }
 },
 "formulas": {
  "uebrig": "max(0 kW, -netz)",
  "anwesend": "in_schedule(arbeitszeit)",
  "soll": "if(sonne_da, wunsch - vorkuehlen, wunsch)",
  "gewollt": "(betrieb == auto and anwesend) or sonne_da"
 },
 "states": {
  "sonne_da": {
   "name": "Sonnenstrom ist übrig",
   "type": "boolean",
   "on_when": "holds(uebrig >= ab_kw, 5 min)",
   "off_when": "unknown(netz) or holds(netz > 0.3 kW, 10 min)",
   "after_restart": "off"
  },
  "fenster_auf": {
   "name": "Fenster steht offen",
   "type": "boolean",
   "on_when": "holds(fenster, 3 min)",
   "off_when": "holds(not fenster, 2 min)",
   "after_restart": "off"
  },
  "laeuft": {
   "name": "Kühlen",
   "type": "boolean",
   "on_when": [
    {
     "Der Betrieb steht nicht auf Aus": "betrieb != abgeschaltet"
    },
    {
     "Das Fenster ist zu": "not fenster_auf"
    },
    {
     "Es ist Arbeitszeit oder Sonnenstrom ist übrig": "gewollt"
    }
   ],
   "off_when_any": [
    {
     "Der Betrieb steht auf Aus": "betrieb == abgeschaltet"
    },
    {
     "Das Fenster steht offen": "fenster_auf"
    },
    {
     "Weder Arbeitszeit noch Sonnenstrom": "not gewollt"
    }
   ],
   "after_restart": "off"
  }
 },
 "outputs": {
  "klima": {
   "on_off": "laeuft",
   "mode": "cool",
   "setpoint": "soll"
  }
 },
 "display": {
  "input": "raum",
  "scale": [
   "18 °C",
   "32 °C"
  ],
  "marks": [
   {
    "name": "Wunsch",
    "at": "wunsch"
   },
   {
    "name": "Mit Sonne",
    "at": "wunsch - vorkuehlen"
   }
  ]
 },
 "status": [
  {
   "when": "betrieb == abgeschaltet",
   "title": "Ausgeschaltet",
   "type": "idle",
   "text": "Der Betrieb steht auf {betrieb}."
  },
  {
   "when": "fenster_auf",
   "title": "Fenster offen",
   "type": "waiting",
   "text": "Das Fenster steht offen. Das Gerät bleibt aus, bis es wieder zu ist."
  },
  {
   "when": "laeuft and sonne_da",
   "title": "Kühlt mit Sonnenstrom vor",
   "type": "solar",
   "text": "Es ist Sonnenstrom übrig. Das Büro wird auf {soll} statt {wunsch} gekühlt. Jetzt sind es {raum}."
  },
  {
   "when": "laeuft",
   "title": "Kühlt",
   "type": "grid",
   "text": "Arbeitszeit. Das Büro wird auf {wunsch} gekühlt. Jetzt sind es {raum}."
  },
  {
   "else": true,
   "title": "Aus",
   "type": "idle",
   "text": "Außerhalb der Arbeitszeit und ohne Sonnenstrom bleibt das Gerät aus."
  }
 ],
 "tests": [
  {
   "name": "Dienstag um zehn wird auf die Wunschtemperatur gekühlt",
   "given": {
    "raum": "27 °C",
    "fenster": "off",
    "netz": "0.5 kW",
    "weekday": "tue",
    "clock": "10:00"
   },
   "after": "2 min",
   "expect": {
    "klima.on_off": "on",
    "klima.setpoint": "25 °C",
    "klima.mode": "cool",
    "status": "Kühlt"
   }
  },
  {
   "name": "Mit Sonnenstrom wird anderthalb Grad tiefer vorgekühlt",
   "given": {
    "raum": "27 °C",
    "fenster": "off",
    "netz": "-2 kW",
    "weekday": "tue",
    "clock": "12:00"
   },
   "after": "6 min",
   "expect": {
    "klima.on_off": "on",
    "klima.setpoint": "23.5 °C",
    "status": "Kühlt mit Sonnenstrom vor"
   }
  },
  {
   "name": "Samstags ohne Sonnenstrom bleibt das Gerät aus",
   "given": {
    "raum": "28 °C",
    "fenster": "off",
    "netz": "0.5 kW",
    "weekday": "sat",
    "clock": "12:00"
   },
   "after": "6 min",
   "expect": {
    "klima.on_off": "off",
    "status": "Aus"
   }
  },
  {
   "name": "Samstags mit Sonnenstrom wird vorgekühlt",
   "given": {
    "raum": "28 °C",
    "fenster": "off",
    "netz": "-2 kW",
    "weekday": "sat",
    "clock": "12:00"
   },
   "after": "6 min",
   "expect": {
    "klima.on_off": "on",
    "klima.setpoint": "23.5 °C"
   }
  },
  {
   "name": "Das Fenster steht drei Minuten offen, dann geht das Gerät aus",
   "given": {
    "raum": "27 °C",
    "fenster": "on",
    "netz": "0.5 kW",
    "weekday": "tue",
    "clock": "10:00"
   },
   "after": "4 min",
   "expect": {
    "klima.on_off": "off",
    "status": "Fenster offen"
   }
  },
  {
   "name": "Nur mit Sonnenstrom heißt, zur Arbeitszeit ohne Sonnenstrom bleibt es aus",
   "given": {
    "raum": "27 °C",
    "fenster": "off",
    "netz": "0.5 kW",
    "weekday": "tue",
    "clock": "10:00",
    "betrieb": "nur_sonne"
   },
   "after": "6 min",
   "expect": {
    "klima.on_off": "off",
    "status": "Aus"
   }
  },
  {
   "name": "Betrieb aus gewinnt immer",
   "given": {
    "raum": "30 °C",
    "fenster": "off",
    "netz": "-5 kW",
    "weekday": "tue",
    "clock": "10:00",
    "betrieb": "abgeschaltet"
   },
   "after": "6 min",
   "expect": {
    "klima.on_off": "off",
    "status": "Ausgeschaltet"
   }
  }
 ]
}
