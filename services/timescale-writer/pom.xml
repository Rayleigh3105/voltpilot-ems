<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.voltpilot</groupId>
    <artifactId>voltpilot-timescale-writer</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>voltpilot-timescale-writer</name>
    <description>Voltpilot-EMS Redpanda -&gt; TimescaleDB writer</description>

    <properties>
        <java.version>21</java.version>
        <testcontainers.version>1.20.6</testcontainers.version>
        <!-- Docker 25+ enforces Engine API >= 1.40; pin the version the
             Testcontainers docker-java client negotiates (see services/api). -->
        <docker.api.version>1.44</docker.api.version>
        <logstash-logback-encoder.version>8.1</logstash-logback-encoder.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Boot 4 defaults to Jackson 3 (tools.jackson.*); this service's own code still
             imports com.fasterxml.jackson.* directly (15 files). spring-boot-jackson2 keeps
             classic Jackson 2 on the classpath alongside the Jackson 3 default so those files
             keep compiling and behaving unchanged. Deprecated, slated for removal upstream -
             the full move to tools.jackson.*/JsonMapper is its own follow-up task, not this one. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Prometheus scrape format for the actuator: registering this registry
             turns the `prometheus` actuator endpoint on (remapped to /metrics in
             application.yml). The writer exposes the Kafka-consumer-lag gauge
             (com.voltpilot.writer.KafkaLagMetricsCollector) - it IS the consumer,
             so the lag metric lives with it. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Consume telemetry.raw from Redpanda, write into the TimescaleDB hypertable.
             Boot 4 moved Kafka autoconfiguration (KafkaAdmin/KafkaTemplate/listener wiring) out
             of spring-boot-autoconfigure into its own spring-boot-kafka module; plain
             spring-kafka no longer gets it transitively. spring-boot-starter-kafka pulls both
             the autoconfigure module and spring-kafka itself. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JSON-Logzeilen per Schalter (logback-spring.xml, docs/k8s-readiness.md Abschnitt
             "Logs"): der Encoder wird nur geladen, wenn voltpilot.logging.format=json steht -
             die Vorgabe bleibt die Textzeile von Spring Boot. 8.1 ist die letzte Linie fuer
             Jackson 2 (9.0 verlangt Jackson 3, das Spring Boot 3.3 nicht mitbringt). Apache-2.0. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback-encoder.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers: real Redpanda + TimescaleDB for the end-to-end pipe
             proof (telemetry.raw -> telemetry hypertable). Skips without Docker. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>redpanda</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Sicherheits-Patch (transitiv über kafka-clients): GHSA-gwq9-9ffj-mvrv,
                 GHSA-q233-g92q-qxp6, GHSA-xqrx-qh46-34m7, behoben in 1.1.10.9. Bleibt auch
                 nach dem Boot-4.1-Wechsel nötig: Boot 4.1.2 bringt selbst nur 1.1.10.7, also
                 weiterhin hinter dem Patch. Beim nächsten Boot-Patch erneut prüfen, ob die
                 Boot-eigene Version aufgeholt hat. -->
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>1.1.10.12</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Pin the Docker Engine API version docker-java negotiates
                         so the Testcontainers pipe test runs on Docker 25+ (see
                         the same pin in services/api). -->
                    <systemPropertyVariables>
                        <api.version>${docker.api.version}</api.version>
                        <!-- Der Kafka-Lag-Sammler ist in PRODUKTION an
                             (application.yml, matchIfMissing) - im Testlauf aus,
                             dieselbe @Scheduled-Falle wie beim api-Flotten-
                             Sammler: Spring cachet Testkontexte, waehrend
                             Testcontainers seine Container nach der Klasse stoppt,
                             ein getakteter Poll liefe danach gegen einen toten
                             Broker weiter. Wer ihn prueft, baut ihn direkt.
                             Dass die Vorgabe AN ist, prueft
                             KafkaLagMetricsWiringTest an der echten application.yml. -->
                        <voltpilot.metrics.kafka-lag.enabled>false</voltpilot.metrics.kafka-lag.enabled>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <DOCKER_API_VERSION>${docker.api.version}</DOCKER_API_VERSION>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
