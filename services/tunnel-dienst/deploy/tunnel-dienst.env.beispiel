# /etc/vp-tunnel-dienst/tunnel-dienst.env  (root:root 0600)
# Konfiguration des Tunnel-Dienstes. Leere Zeilen und Kommentare sind erlaubt.

# Portal-API und Keycloak (Token über client_credentials). Nur https.
VP_TUNNEL_API_URL=https://portal.voltpilot.de
VP_TUNNEL_TOKEN_URL=https://portal.voltpilot.de/auth/realms/voltpilot/protocol/openid-connect/token
VP_TUNNEL_CLIENT_ID=voltpilot-tunnel-dienst
# Das Secret kommt aus /etc/vp-tunnel-dienst/client-secret (systemd LoadCredential).

# MUSS zur API passen (voltpilot.fernwartung.box-netz / techniker-netz),
# sonst wird der Soll-Stand verworfen.
VP_TUNNEL_BOX_NETZ=10.10.16.0/20
VP_TUNNEL_TECHNIKER_NETZ=10.10.32.0/24

# WireGuard-Schnittstelle (wg-quick@wg-wartung) und eigene nft-Tabelle.
VP_TUNNEL_SCHNITTSTELLE=wg-wartung
VP_TUNNEL_NFT_TABELLE=voltpilot_wartung

# TCP-Ports, die ein Techniker im offenen Fenster auf der Box erreicht:
# 2222 = Dropbear im Tunnel, 8484 = lokale Web-App der Box.
VP_TUNNEL_PORTS=2222,8484

# Abrufintervall; längstes Fenster, das der Dienst setzt (unabhängig von der
# API); höchstens so viele Peer-Entfernungen je Lauf, sonst Alarm.
VP_TUNNEL_INTERVALL=30s
VP_TUNNEL_MAX_FENSTER=24h
VP_TUNNEL_MAX_ENTFERNEN=10

# Neue Techniker-Verbindungen ins Kernel-Log (journalctl -k): ja | nein
VP_TUNNEL_VERBINDUNGEN_PROTOKOLLIEREN=ja

# Schlüsselausgabe (Fenster-Schlüssel): Auf diesem TCP-Port der Server-Adresse
# im Techniker-Netz (bei den Vorgaben 10.10.32.1) fragt eine Box, wessen
# SSH-Schlüssel sich gerade bei ihr anmelden darf. Leer oder auskommentiert:
# abgeschaltet, keine Regel in der Firewall-Basis. Mindestens 1024.
# Wer den Wert setzt oder ändert, ändert die Firewall-Basis: offene Fenster
# schließen beim nächsten Lauf einmal (README, "Schlüsselausgabe").
VP_TUNNEL_SCHLUESSEL_PORT=8022
