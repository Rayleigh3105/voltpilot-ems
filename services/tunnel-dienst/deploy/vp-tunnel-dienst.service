# /etc/systemd/system/vp-tunnel-dienst.service
# VoltPilot Tunnel-Dienst: setzt den Soll-Stand der Fernwartung auf der
# Wartungs-VM um. Installation: services/tunnel-dienst/README.md
[Unit]
Description=VoltPilot Tunnel-Dienst (Fernwartung: Soll-Stand auf WireGuard und nftables)
Documentation=https://git.tecmaxx.de/mamotec/voltpilot-ems/src/branch/main/services/tunnel-dienst/README.md
Wants=network-online.target
After=network-online.target nftables.service wg-quick@wg-wartung.service
Requires=wg-quick@wg-wartung.service

[Service]
Type=simple
ExecStart=/usr/local/bin/vp-tunnel-dienst lauf
Restart=always
RestartSec=10

# Eigener Benutzer, nur CAP_NET_ADMIN (für wg und nft) - kein root.
User=vp-tunnel
Group=vp-tunnel
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes

# Konfiguration; das Client-Secret als Credential, nie als Umgebungsvariable.
EnvironmentFile=/etc/vp-tunnel-dienst/tunnel-dienst.env
LoadCredential=client-secret:/etc/vp-tunnel-dienst/client-secret

# Zwischenstand und status.json unter /var/lib/vp-tunnel-dienst.
StateDirectory=vp-tunnel-dienst
StateDirectoryMode=0700
UMask=0077

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
