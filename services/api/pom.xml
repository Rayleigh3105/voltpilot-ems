<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.voltpilot</groupId>
    <artifactId>voltpilot-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>voltpilot-api</name>
    <description>Voltpilot-EMS portal backend / API (REST + WebSocket)</description>

    <properties>
        <java.version>21</java.version>
        <!-- 1.20.x ships docker-java 3.4.x which negotiates the Docker API
             version; 1.19.x pins v1.32, which Docker 25+ (min API 1.40) rejects. -->
        <testcontainers.version>1.20.6</testcontainers.version>
        <docker.api.version>1.44</docker.api.version>
        <measurement.catalog.version>2026.09.11.1</measurement.catalog.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Prometheus scrape format for the actuator (com.voltpilot.api.metrics):
             the fleet-operations gauges an alert rule watches. Registering this
             registry is what turns the `prometheus` actuator endpoint on; the
             endpoint is exposed + remapped to /metrics in application.yml. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Persistence: plain JDBC (repository-encapsulated per architecture §10),
             Postgres/TimescaleDB driver, and Flyway migrations owning the schema. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- MQTT (zero-touch provisioning): on device claim the api publishes the
             retained provision/{ref}/config so a waiting device is configured the
             moment it is claimed. Best-effort - see ProvisioningPublisher. -->
        <dependency>
            <groupId>org.eclipse.paho</groupId>
            <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
            <version>1.2.5</version>
        </dependency>

        <!-- X.509 for first-boot device enrollment (enrollment package): the api
             parses device CSRs and signs client certs with the device CA,
             mirroring the openssl extensions of tools/pki/voltpilot-ca.sh.
             bcpkix pulls bcprov + bcutil transitively. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers: real TimescaleDB + Keycloak for the RLS-isolation and
             OIDC token-validation integration tests. Auto-skip without Docker. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.dasniko</groupId>
            <artifactId>testcontainers-keycloak</artifactId>
            <version>3.5.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The versioned measurement-point catalog remains ONE generated truth
             at repo root. Package that canonical dist artifact into the api jar
             instead of maintaining a copied/hand-edited API catalog. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/../../catalog/measurement-points/dist</directory>
                <targetPath>measurementcatalog</targetPath>
                <includes>
                    <include>measurement-point-catalog-${measurement.catalog.version}.json</include>
                </includes>
            </resource>
        </resources>
        <!-- Load the canonical dev realm (single source of truth) onto the test
             classpath so the Keycloak Testcontainer imports the same realm the
             compose stack uses - no drifting copy. -->
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../../infra/local/keycloak</directory>
                <targetPath>keycloak</targetPath>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Pin the Docker Engine API version the Testcontainers
                         (docker-java) client negotiates. Docker 25+ enforces a
                         minimum of 1.40 and rejects docker-java's older default,
                         which otherwise makes the Testcontainers tests skip.
                         Override with -Ddocker.api.version=... if needed. -->
                    <systemPropertyVariables>
                        <api.version>${docker.api.version}</api.version>
                        <!-- Der Flotten-Metrik-Sammler ist in PRODUKTION an
                             (application.yml, matchIfMissing) - im Testlauf aber
                             aus, und zwar nicht aus Bequemlichkeit: Spring
                             CACHET Testkontexte, waehrend Testcontainers seine
                             Container nach der Klasse STOPPT. Ein getakteter Job
                             laeuft danach in jedem zwischengespeicherten Kontext
                             gegen eine tote Datenbank weiter und erzeugt in allen
                             folgenden Klassen Verbindungs-Validierungsstuerme
                             (gemessen: 56 Hikari-Warnungen gegen 0 ohne ihn).
                             Wer den Sammler wirklich prueft, schaltet ihn in
                             seiner Testklasse ausdruecklich ein - inline gesetzte
                             Test-Eigenschaften schlagen diese Systemeigenschaft.
                             Dass die AUSGELIEFERTE Vorgabe AN ist, prueft
                             FleetMetricsWiringTest an der echten
                             application.yml. -->
                        <voltpilot.metrics.fleet.enabled>false</voltpilot.metrics.fleet.enabled>
                        <!-- Der Verbraucher-Metrik-Sammler (Inkrement 5) ist
                             dieselbe @Scheduled-Falle - im Testlauf aus, in
                             PRODUKTION an (application.yml, matchIfMissing). -->
                        <voltpilot.metrics.consumer.enabled>false</voltpilot.metrics.consumer.enabled>
                        <!-- Der Datenhaltungs-Metrik-Sammler (DbHealthMetrics,
                             §6.3) ist dieselbe @Scheduled-Falle - im Testlauf
                             aus, in PRODUKTION an (application.yml,
                             matchIfMissing). Dass die Vorgabe AN ist, prueft
                             DbHealthMetricsWiringTest an der echten application.yml. -->
                        <voltpilot.metrics.db.enabled>false</voltpilot.metrics.db.enabled>
                        <!-- Der getaktete v2-Komposition-Abgleich ist dieselbe
                             @Scheduled-Falle - im Testlauf aus, in PRODUKTION an
                             (application.yml + matchIfMissing). Der Start-Lauf
                             selbst bleibt an: die Testklassen stossen ihn
                             ausdruecklich selbst an (backfillRunner.run()).
                             Dass die AUSGELIEFERTE Vorgabe AN ist, prueft
                             V2SiteBackfillReconcileWiringTest an der echten
                             application.yml. -->
                        <voltpilot.entities.backfill.reconcile-enabled>false</voltpilot.entities.backfill.reconcile-enabled>
                        <!-- Der getaktete Abgleich der Bestands-Uebernahme
                             (Einheitsmodell Stufe 2) ist dieselbe
                             @Scheduled-Falle - im Testlauf aus, in PRODUKTION an
                             (application.yml + matchIfMissing). Der Start-Lauf
                             bleibt an; die Testklassen stossen ihn ausdruecklich
                             selbst an. Dass die AUSGELIEFERTE Vorgabe AN ist,
                             prueft ComponentAdoptionWiringTest an der echten
                             application.yml. -->
                        <voltpilot.components.adoption.reconcile-enabled>false</voltpilot.components.adoption.reconcile-enabled>
                        <!-- Der Erneuerungs-Takt der Handeingriffe (Steuerung
                             Stufe 4, B6) ist in PRODUKTION an (application.yml,
                             matchIfMissing) - im Testlauf aus, aus demselben
                             Grund wie die zwei Sammler darueber. Wer ihn prueft,
                             ruft renewOnce() direkt. -->
                        <voltpilot.interventions.renewal-enabled>false</voltpilot.interventions.renewal-enabled>
                        <!-- Die Bestandsuebernahme der Standorte (UEMS AP-02
                             IP-9) ist ein START-Lauf, kein Takt - aber in jeder
                             Testklasse mit Dev-Saat (local-Profil) bekaeme
                             `demo2` sonst schon beim Start einen Standort und
                             `demo` drei Vorschlaege, und die Antworten der
                             Anlage truegen das Feld `standort`. Im Testlauf aus,
                             in PRODUKTION an (application.yml); wer ihn prueft,
                             ruft BestandsuebernahmeLaeufer.lauf() selbst. Dass
                             die AUSGELIEFERTE Vorgabe AN ist, prueft
                             BestandsuebernahmeWiringTest an der echten
                             application.yml. -->
                        <voltpilot.uems.bestandsuebernahme.enabled>false</voltpilot.uems.bestandsuebernahme.enabled>
                        <!-- Der Verdichtungs-Takt der Viertelstundenwerte (UEMS
                             AP-07 IP-12) ist dieselbe @Scheduled-Falle - im
                             Testlauf aus, in PRODUKTION an (application.yml,
                             matchIfMissing). Er schriebe sonst in jedem
                             gecachten Testkontext gegen eine gestoppte
                             Datenbank weiter. Wer ihn prueft, ruft
                             ViertelstundeVerdichter.lauf() selbst. Dass die
                             AUSGELIEFERTE Vorgabe AN ist, prueft
                             ViertelstundeWiringTest an der echten
                             application.yml. -->
                        <voltpilot.uems.viertelstunde.enabled>false</voltpilot.uems.viertelstunde.enabled>
                        <!-- Und der Stundenlauf der Endgueltigkeit samt Tageslauf
                             (AP-07 IP-13) ist dieselbe @Scheduled-Falle: im
                             Testlauf aus, in PRODUKTION an (application.yml,
                             matchIfMissing). Wer ihn prueft, ruft
                             EndgueltigkeitLauf.umschalten() und
                             TagVerdichter.lauf() selbst; dass die AUSGELIEFERTE
                             Vorgabe AN ist, prueft EndgueltigkeitWiringTest an
                             der echten application.yml. -->
                        <voltpilot.uems.endgueltigkeit.enabled>false</voltpilot.uems.endgueltigkeit.enabled>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <DOCKER_API_VERSION>${docker.api.version}</DOCKER_API_VERSION>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
