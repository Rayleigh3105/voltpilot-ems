#!/bin/sh
# config_clock type=utc time=hh:mm:ss date=dd.mm.yyyy
# Die Attrappe stellt keine echte Uhr: Sie haelt den Versatz zur Uhr des
# Rechners fest; "date" daneben rechnet ihn ein.
. "$(dirname "$0")/attrappe.sh"
typ="$(param type "$@")"
zeit="$(param time "$@")"
tag="$(param date "$@")"
[ "$typ" = utc ] || falsch "die Attrappe kennt nur type=utc"
printf '%s' "$zeit" | grep -Eq '^([01]?[0-9]|2[0-3]):[0-5]?[0-9]:[0-5]?[0-9]$' || falsch "Invalid time format"
printf '%s' "$tag" | grep -Eq '^[0-3]?[0-9]\.[01]?[0-9]\.[0-9]{4}$' || falsch "Invalid date format"
zahl() { _z="${1#0}"; echo "${_z:-0}"; }
h="$(zahl "${zeit%%:*}")"
rest="${zeit#*:}"
mi="$(zahl "${rest%%:*}")"
s="$(zahl "${rest#*:}")"
d="$(zahl "${tag%%.*}")"
rest="${tag#*.}"
mo="$(zahl "${rest%%.*}")"
y="${rest#*.}"
# Tage seit dem 1.1.1970 (Kalender wie die Uhr des Geraets).
[ "$mo" -gt 2 ] || y=$((y - 1))
era=$((y / 400))
yoe=$((y - era * 400))
mp=$(((mo + 9) % 12))
doy=$(((153 * mp + 2) / 5 + d - 1))
doe=$((yoe * 365 + yoe / 4 - yoe / 100 + doy))
tage=$((era * 146097 + doe - 719468))
soll=$((tage * 86400 + h * 3600 + mi * 60 + s))
setze uhr/versatz "$((soll - $(/bin/date -u +%s)))"
merke "type=utc time=$zeit date=$tag"
