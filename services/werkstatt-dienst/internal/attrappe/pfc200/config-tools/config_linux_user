#!/bin/sh
# config_linux_user user=<u> hash=<Zeile im Format von /etc/shadow>
. "$(dirname "$0")/attrappe.sh"
u="$(param user "$@")"
h="$(param hash "$@")"
# Das echte Werkzeug lehnt user=root grundsaetzlich ab, ohne jede Ausgabe
# (WAGO-Quelltext config_linux_user.c/shadow_functions.c, FW22 und FW24+
# gleich: FillUserData/FillUserDataFromHash geben INVALID_PARAMETER=2 zurueck,
# bevor sie etwas ausgeben). root setzt sein Passwort ueber usermod.
[ "$u" = root ] && exit 2
case "$u" in admin | user) ;; *) falsch "Invalid user ($u)" ;; esac
# Die Attrappe nimmt nur den Hash: Ein Passwort als Argument stuende in der
# Prozessliste des Geraets.
if hat new-password "$@" || hat confirm-password "$@"; then
  falsch "die Attrappe nimmt kein Passwort als Argument, nur hash="
fi
hashfeld="${h%%:*}"
printf '%s' "$hashfeld" | grep -Eq '^\$6\$[./0-9A-Za-z]{1,16}\$[./0-9A-Za-z]{86}$' || falsch "Invalid hash"
# Das echte Werkzeug baut "user:$hash" und gibt die Zeile an sgetspent()
# (FillUserDataFromHash); das verlangt die vollstaendige Shadow-Zeile hinter
# dem Nutzernamen (hash:lstchg:min:max:warn:inactive:expire:flag, siehe
# get_user_hash --shadow-get-info und die Hilfe des Werkzeugs: "password hash
# and additional infos in /etc/shadow format"). Fehlen die Felder nach dem
# Hash ganz (kein ":" in hash=), scheitert sgetspent() an der unvollstaendigen
# Zeile und das Werkzeug endet mit SYSTEM_CALL_ERROR=7, ebenfalls ohne jede
# Ausgabe (ct_error_handling.h bzw. ctutil/error_codes.h, FW22 und FW24+
# gleich).
case "$h" in *:*) ;; *) exit 7 ;; esac
setze "benutzer/$u.hash" "$hashfeld"
merke "user=$u hash=gesetzt"
