{
  "realm": "voltpilot",
  "enabled": true,
  "displayName": "Voltpilot-EMS (dev)",
  "loginTheme": "voltpilot",
  "internationalizationEnabled": true,
  "supportedLocales": ["de", "en"],
  "defaultLocale": "de",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "rememberMe": true,
  "ssoSessionIdleTimeout": 43200,
  "ssoSessionMaxLifespan": 86400,
  "ssoSessionIdleTimeoutRememberMe": 7776000,
  "ssoSessionMaxLifespanRememberMe": 15552000,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "roles": {
    "realm": [
      {
        "name": "operator",
        "description": "Portal-User, legacy accounts only: customer scoped to one tenant via tenant_id. Since UEMS AP-03 IP-3 new customer accounts get no realm role (dev)"
      },
      {
        "name": "admin",
        "description": "Tenant admin (dev, legacy)"
      },
      {
        "name": "site-admin",
        "description": "Site administrator: OCPP availability, soft reset, allowlisted configuration and local-auth operations (dev)"
      },
      {
        "name": "platform-admin",
        "description": "Portal-Admin: platform operator, manages tenants and users across all tenants (dev)"
      },
      {
        "name": "partner",
        "description": "Partner account (installer, UEMS AP-03 E7): NEVER a tenant_id; reaches a customer area only through a granted Unterstuetzung (dev)"
      },
      {
        "name": "edge-release-publisher",
        "description": "OTA release automation: may ONLY register a signed edge release (POST /api/v1/admin/edge-releases + its next-seq read). Never a rollout, never a device target (dev)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "voltpilot-release-publisher",
      "name": "VoltPilot OTA Release Publisher",
      "description": "Service account for the edge-* tag pipeline. Client credentials only - no login, no browser flow, no password grant.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "secret": "voltpilot-release-publisher-dev-secret",
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "voltpilot-api",
      "name": "Voltpilot Portal API",
      "description": "Confidential OIDC client for the Spring Boot portal API (bearer + service auth).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "secret": "voltpilot-api-dev-secret",
      "redirectUris": [
        "http://localhost:8090/*"
      ],
      "webOrigins": [
        "http://localhost:8090"
      ],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "voltpilot-frontend",
      "name": "Voltpilot Web Portal",
      "description": "Public OIDC client for the React (Vite) portal SPA (PKCE).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://192.168.2.77:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://192.168.2.77:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-voltpilot-release-publisher",
