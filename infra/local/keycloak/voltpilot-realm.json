{
  "realm": "voltpilot",
  "enabled": true,
  "displayName": "Voltpilot-EMS (dev)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "operator", "description": "Tenant operator (dev)" },
      { "name": "admin", "description": "Tenant admin (dev)" }
    ]
  },
  "clients": [
    {
      "clientId": "voltpilot-api",
      "name": "Voltpilot Portal API",
      "description": "Confidential OIDC client for the Spring Boot portal API (bearer + service auth).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "secret": "voltpilot-api-dev-secret",
      "redirectUris": ["http://localhost:8090/*"],
      "webOrigins": ["http://localhost:8090"],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "voltpilot-frontend",
      "name": "Voltpilot Web Portal",
      "description": "Public OIDC client for the React (Vite) portal SPA (PKCE).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "email": "demo@voltpilot.local",
      "firstName": "Demo",
      "lastName": "Operator",
      "attributes": {
        "tenant_id": ["00000000-0000-0000-0000-000000000001"]
      },
      "credentials": [
        { "type": "password", "value": "demo", "temporary": false }
      ],
      "realmRoles": ["operator"]
    }
  ]
}
