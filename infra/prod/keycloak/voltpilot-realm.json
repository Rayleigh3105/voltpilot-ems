{
  "realm": "voltpilot",
  "enabled": true,
  "displayName": "Voltpilot-EMS",
  "loginTheme": "voltpilot",
  "internationalizationEnabled": true,
  "supportedLocales": ["de", "en"],
  "defaultLocale": "de",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "operator", "description": "Portal-User: customer, scoped to one tenant via tenant_id" },
      { "name": "admin", "description": "Tenant admin (legacy)" },
      { "name": "platform-admin", "description": "Portal-Admin: platform operator, manages tenants and users across all tenants" }
    ]
  },
  "clients": [
    {
      "clientId": "voltpilot-api",
      "name": "Voltpilot Portal API",
      "description": "Confidential OIDC client for the Spring Boot portal API (bearer + service auth).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "secret": "${VP_API_CLIENT_SECRET:change-me}",
      "redirectUris": ["${VP_PUBLIC_ORIGIN}/*"],
      "webOrigins": ["${VP_PUBLIC_ORIGIN}"],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "voltpilot-frontend",
      "name": "Voltpilot Web Portal",
      "description": "Public OIDC client for the React (Vite) portal SPA (PKCE).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["${VP_PUBLIC_ORIGIN}/*"],
      "webOrigins": ["${VP_PUBLIC_ORIGIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-voltpilot-api",
      "enabled": true,
      "serviceAccountClientId": "voltpilot-api",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@voltpilot.local",
      "firstName": "Platform",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "${VP_PORTAL_ADMIN_PASSWORD:admin}", "temporary": false }
      ],
      "realmRoles": ["platform-admin"]
    },
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "email": "demo@voltpilot.local",
      "firstName": "Demo",
      "lastName": "Operator",
      "attributes": {
        "tenant_id": ["00000000-0000-0000-0000-000000000001"]
      },
      "credentials": [
        { "type": "password", "value": "demo", "temporary": false }
      ],
      "realmRoles": ["operator"]
    },
    {
      "username": "demo2",
      "enabled": true,
      "emailVerified": true,
      "email": "demo2@voltpilot.local",
      "firstName": "Nordwind",
      "lastName": "Operator",
      "attributes": {
        "tenant_id": ["10000000-0000-0000-0000-000000000001"]
      },
      "credentials": [
        { "type": "password", "value": "demo2", "temporary": false }
      ],
      "realmRoles": ["operator"]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "name": "declarative-user-profile",
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\": \"ADMIN_EDIT\", \"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"email\", \"displayName\": \"${email}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"tenant_id\", \"displayName\": \"Tenant ID\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}}]}"
          ]
        }
      }
    ]
  }
}
