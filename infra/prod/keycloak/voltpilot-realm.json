{
  "realm": "voltpilot",
  "enabled": true,
  "displayName": "Voltpilot-EMS",
  "loginTheme": "voltpilot",
  "internationalizationEnabled": true,
  "supportedLocales": ["de", "en"],
  "defaultLocale": "de",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "rememberMe": true,
  "ssoSessionIdleTimeout": 43200,
  "ssoSessionMaxLifespan": 86400,
  "ssoSessionIdleTimeoutRememberMe": 7776000,
  "ssoSessionMaxLifespanRememberMe": 15552000,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "passwordPolicy": "length(12) and notUsername and passwordHistory(3)",
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "attributes": {
    "adminEventsExpiration": "7776000"
  },
  "browserFlow": "voltpilot-browser",
  "directGrantFlow": "voltpilot-direct-grant",
  "roles": {
    "realm": [
      { "name": "operator", "description": "Portal-User, legacy accounts only: customer scoped to one tenant via tenant_id. Since UEMS AP-03 IP-3 new customer accounts get no realm role" },
      { "name": "admin", "description": "Tenant admin (legacy)" },
      { "name": "site-admin", "description": "Site administrator: OCPP availability, soft reset, allowlisted configuration and local-auth operations" },
      { "name": "platform-admin", "description": "Portal-Admin: platform operator, manages tenants and users across all tenants" },
      { "name": "partner", "description": "Partner account (installer, UEMS AP-03 E7): NEVER a tenant_id; reaches a customer area only through a granted Unterstuetzung" },
      { "name": "edge-release-publisher", "description": "OTA release automation: may ONLY register a signed edge release (POST /api/v1/admin/edge-releases + its next-seq read). Never a rollout, never a device target - see docs/ota-signing.md." }
    ]
  },
  "clients": [
    {
      "clientId": "voltpilot-release-publisher",
      "name": "VoltPilot OTA Release Publisher",
      "description": "Service account for the edge-* tag pipeline: client credentials only, the token carries edge-release-publisher and nothing else. Ships DISABLED - enable it only after setting VP_RELEASE_PUBLISHER_SECRET (infra/prod/keycloak/README.md).",
      "enabled": false,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "secret": "${VP_RELEASE_PUBLISHER_SECRET:change-me}",
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "voltpilot-api",
      "name": "Voltpilot Portal API",
      "description": "Confidential OIDC client for the Spring Boot portal API (bearer + service auth).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "secret": "${VP_API_CLIENT_SECRET}",
      "redirectUris": ["${VP_PUBLIC_ORIGIN}/*"],
      "webOrigins": ["${VP_PUBLIC_ORIGIN}"],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "voltpilot-frontend",
      "name": "Voltpilot Web Portal",
      "description": "Public OIDC client for the React (Vite) portal SPA (PKCE).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["${VP_PUBLIC_ORIGIN}/*"],
      "webOrigins": ["${VP_PUBLIC_ORIGIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-voltpilot-release-publisher",
      "enabled": true,
      "serviceAccountClientId": "voltpilot-release-publisher",
      "realmRoles": ["edge-release-publisher"]
    },
    {
      "username": "service-account-voltpilot-api",
      "enabled": true,
      "serviceAccountClientId": "voltpilot-api",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@voltpilot.local",
      "firstName": "Platform",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "${VP_PORTAL_ADMIN_PASSWORD}", "temporary": false }
      ],
      "realmRoles": ["platform-admin"]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "voltpilot-rolle-platform-admin",
      "config": { "condUserRole": "platform-admin", "negate": "false" }
    },
    {
      "alias": "voltpilot-rolle-nicht-platform-admin",
      "config": { "condUserRole": "platform-admin", "negate": "true" }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "voltpilot-browser",
      "description": "Browser-Anmeldung (UEMS AP-20 IP-20, E12): zweiter Faktor Pflicht fuer platform-admin (VoltPilot-Betrieb), fuer alle anderen Konten waehlbar",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "identity-provider-redirector", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 25, "userSetupAllowed": false },
        { "authenticatorFlow": true, "flowAlias": "voltpilot-browser-formular", "requirement": "ALTERNATIVE", "priority": 30, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "voltpilot-browser-formular",
      "description": "Benutzername und Passwort, danach der zweite Faktor je Konto",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-username-password-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticatorFlow": true, "flowAlias": "voltpilot-browser-otp-betrieb", "requirement": "CONDITIONAL", "priority": 20, "userSetupAllowed": false },
        { "authenticatorFlow": true, "flowAlias": "voltpilot-browser-otp-gewaehlt", "requirement": "CONDITIONAL", "priority": 30, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "voltpilot-browser-otp-betrieb",
      "description": "platform-admin: OTP Pflicht; ohne eingerichtetes OTP verlangt Keycloak die Einrichtung bei dieser Anmeldung",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticatorConfig": "voltpilot-rolle-platform-admin", "authenticator": "conditional-user-role", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "voltpilot-browser-otp-gewaehlt",
      "description": "Alle anderen Konten: OTP nur, wenn das Konto es selbst eingerichtet hat",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticatorConfig": "voltpilot-rolle-nicht-platform-admin", "authenticator": "conditional-user-role", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "conditional-user-configured", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 30, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "voltpilot-direct-grant",
      "description": "Passwort-Grant (UEMS AP-20 IP-20, E12): kein Token fuer platform-admin, OTP fuer Konten, die es eingerichtet haben",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "direct-grant-validate-username", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "direct-grant-validate-password", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false },
        { "authenticatorFlow": true, "flowAlias": "voltpilot-direct-grant-betrieb", "requirement": "CONDITIONAL", "priority": 30, "userSetupAllowed": false },
        { "authenticatorFlow": true, "flowAlias": "voltpilot-direct-grant-otp-gewaehlt", "requirement": "CONDITIONAL", "priority": 40, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "voltpilot-direct-grant-betrieb",
      "description": "platform-admin: kein Passwort-Grant - Betriebskonten melden sich nur im Browser mit zweitem Faktor an",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticatorConfig": "voltpilot-rolle-platform-admin", "authenticator": "conditional-user-role", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "deny-access-authenticator", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "voltpilot-direct-grant-otp-gewaehlt",
      "description": "Alle anderen Konten: OTP nur, wenn das Konto es selbst eingerichtet hat",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticatorConfig": "voltpilot-rolle-nicht-platform-admin", "authenticator": "conditional-user-role", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "conditional-user-configured", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false },
        { "authenticator": "direct-grant-validate-otp", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 30, "userSetupAllowed": false }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "name": "declarative-user-profile",
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\": \"ADMIN_EDIT\", \"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"email\", \"displayName\": \"${email}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"tenant_id\", \"displayName\": \"Tenant ID\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}}]}"
          ]
        }
      }
    ]
  }
}
