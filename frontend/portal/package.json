{
  "name": "voltpilot-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voltpilot-EMS web portal (React + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:agents-md": "vitest run src/agentsMdBudget.test.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:csp": "test/csp-smoke.sh",
    "test:cache": "test/cache-smoke.sh",
    "test:bundle": "test/bundle-smoke.sh"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "keycloak-js": "^26.0.5",
    "leaflet": "^1.9.4",
    "motion": "13.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
