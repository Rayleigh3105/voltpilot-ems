{
  "name": "@voltpilot/node-red-vp-palette",
  "version": "0.2.0",
  "description": "VoltPilot Edge-App Node-RED-Palette: vp-telemetrie, vp-sollwert, vp-status, vp-inverter-config, vp-sources-config und vp-quelle verbinden die Kunden-I/O-Flows mit dem lokalen Bus des VoltPilot Core-Agenten; ab 0.2.0 zusaetzlich die v2-Flow-Runtime-Knoten vp-desired (Wunsch/Arbitrierung), vp-entity-read, vp-feed und vp-notify.",
  "license": "UNLICENSED",
  "private": true,
  "keywords": [
    "node-red"
  ],
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "vp-core": "nodes/vp-core.js",
      "vp-telemetrie": "nodes/vp-telemetrie.js",
      "vp-sollwert": "nodes/vp-sollwert.js",
      "vp-status": "nodes/vp-status.js",
      "vp-inverter-config": "nodes/vp-inverter-config.js",
      "vp-control-readback": "nodes/vp-control-readback.js",
      "vp-sources-config": "nodes/vp-sources-config.js",
      "vp-quelle": "nodes/vp-quelle.js",
      "vp-netz": "nodes/vp-netz.js",
      "vp-verbraucher": "nodes/vp-verbraucher.js",
      "vp-test-request": "nodes/vp-test-request.js",
      "vp-test-result": "nodes/vp-test-result.js",
      "vp-desired": "nodes/vp-desired.js",
      "vp-entity-read": "nodes/vp-entity-read.js",
      "vp-feed": "nodes/vp-feed.js",
      "vp-notify": "nodes/vp-notify.js"
    }
  },
  "dependencies": {
    "mqtt": "^5.10.1"
  },
  "devDependencies": {
    "mocha": "^10.7.3",
    "node-red": "^4.0.5",
    "node-red-node-test-helper": "^0.3.4",
    "aedes": "^0.51.3"
  },
  "scripts": {
    "test": "mocha test/*_spec.js --timeout 10000 --exit"
  }
}
