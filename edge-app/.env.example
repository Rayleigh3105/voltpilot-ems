# VoltPilot Edge-App - Konfiguration (alles optional; ohne .env läuft das
# Gerät mit Standardwerten und erzeugt sich eine dauerhafte Referenz-ID).

# Cloud-Endpunkte (Standard: die VoltPilot-Produktionsumgebung).
#VP_PORTAL_BASE_URL=https://portal.voltpilot.de
#VP_MQTT_HOST=mqtt.voltpilot.de
#VP_MQTT_PORT=8883

# Geräte-Referenz (Edge-Referenz / Aufkleber-ID). Leer = automatisch erzeugt
# und in der lokalen Webansicht angezeigt.
#VP_REF=VP-XXXX-0001

# Batterie-Grenzen für die lokalen Guards (pro Anlage von VoltPilot gesetzt).
#VP_MAX_CHARGE_KW=50
#VP_MAX_DISCHARGE_KW=50
#VP_SOC_MIN_PCT=5
#VP_SOC_MAX_PCT=95

# Telemetrie-Puffer bei Cloud-Ausfall (Stunden, älteste Werte weichen zuerst).
#VP_BUFFER_HOURS=48

# Erkennung "Gerät wurde in der Cloud entfernt" (geraet_entfernt): erst nach
# einem UNUNTERBROCHENEN Fenster eindeutiger "nicht beansprucht"-Antworten des
# ERREICHBAREN Portals (Minuten UND aufeinanderfolgende Abfragen; Ausfälle /
# Timeouts / 5xx zählen nie und setzen den Zähler zurück). Standard bewusst
# großzügig, damit ein kurzer Portal-Schluckauf nie als Entfernung gilt.
#VP_UNCLAIM_CONFIRM_MINUTES=20
#VP_UNCLAIM_CONFIRM_POLLS=4

# Globaler Not-Aus der Wechselrichter-Steuerung. Standard 'true' - das ist NUR
# der grobe Schalter; ob ein Gerät wirklich geschrieben wird, entscheidet die
# Freigabe pro Modell (First-Light-Kalibrierung / Zertifizierungs-Allowlist).
# Auf 'false' setzen, um jede Steuerung geräteweit zu stoppen (nur lesen).
#VP_CONTROL_ENABLED=true

# Lokale Ports.
#VP_WEB_PORT=8484
#VP_NODERED_PORT=1881
#VP_BUS_PORT=1884
# Host-Port des Modbus-Datenspiegels (Nur-Lese-Modbus-TCP fuer die
# Gebaeudeautomation, z. B. Loxone; siehe MODBUS-SPIEGEL.md). Der Spiegel
# selbst wird auf der Geraeteseite (:8484 -> Einrichten) eingeschaltet und
# ist standardmaessig AUS; ohne aktivierten Spiegel wird die Verbindung
# abgewiesen.
#VP_MIRROR_PORT=502

# Node-RED-Editor-Zugang (Service-Zugang für VoltPilot). PFLICHT: ohne ein
# eigenes, nicht-Standard-Passwort startet der Node-RED-Editor NICHT
# (fail closed - der frühere Standard "voltpilot" wird verweigert).
#VP_NODERED_USER=voltpilot
#VP_NODERED_PASSWORD=<eigenes-starkes-passwort>

# Image-Version (Rollback-Hebel). Ungesetzt = 'latest' wie bisher: jedes
# `up -d` zieht den neuesten Stand. Ein Tag- oder Digest-Pin friert das Gerät
# auf einen geprüften Stand ein - und ist der saubere, wiederholbare Rollback.
# Bequemer per ./update.sh --tag <tag> | --core-image <ref> | --latest gesetzt
# (schreibt genau diese Schlüssel in die .env, sonst nichts).
#VP_EDGE_IMAGE_TAG=latest
#VP_EDGE_CORE_IMAGE=git.tecmaxx.de/mamotec/voltpilot-ems/edge-app-core@sha256:<digest>
#VP_EDGE_NODERED_IMAGE=git.tecmaxx.de/mamotec/voltpilot-ems/edge-app-nodered@sha256:<digest>

# --- NUR ENTWICKLUNG: niemals auf Kundengeräten setzen -----------------------
# Feste Identität (überspringt das Enrollment) + Klartext-MQTT zur Cloud.
#VP_DEV_TENANT_ID=
#VP_DEV_SITE_ID=
#VP_DEV_DEVICE_ID=
#VP_DEV_CLOUD_URL=tcp://broker:1883

# Verbrauchssteuerung §19 Inkrement 5: der Verbraucher-Steuerungs-Schalter,
# getrennt vom Wechselrichter-Not-Aus VP_CONTROL_ENABLED. Standard 'false' = der
# Edge sendet nie ein Verbraucher-Kommando, bis er je Anlage nach dem Runbook
# (docs/verbrauchssteuerung-betrieb.md) eingeschaltet wird.
#VP_CONSUMER_CONTROL_ENABLED=false

# --- OCPP-Ladepunkte (Lastmanagement) --------------------------------------
# Vorgabe AN: die Box oeffnet ohne jeden .env-Schritt einen
# OCPP-1.6J-Websocket-Server im LAN, den die Ladesaeulen anwaehlen
# (ws://<box>:8887/ocpp/<Kennung>). Zum Abschalten hier 'false' eintragen.
# Zugang bekommt NUR eine EINGETRAGENE Kennung - im Portal (Ladesaeule anbinden)
# oder auf :8484; eine unbekannte Saeule wird schon beim Verbindungsaufbau
# abgewiesen und protokolliert, und eine frische Box hat eine LEERE Liste.
# LAN-only wie :8484 und der Node-RED-Editor: nie oeffentlich erreichbar machen.
#VP_OCPP_ENABLED=true
#VP_OCPP_PORT=8887
# Hinweis: die LEBENDE Zuteilung (das Verteilen des Ladebudgets) braucht
# zusaetzlich VP_CONTROL_ENABLED und VP_CONSUMER_CONTROL_ENABLED. Ohne sie
# laufen die Saeulen auf ihrem hinterlegten Sicherheitsprofil - sicher, nur
# nicht optimiert - und die Weboberflaeche sagt das.
