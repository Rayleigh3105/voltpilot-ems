# VoltPilot Edge-App - Konfiguration (alles optional; ohne .env läuft das
# Gerät mit Standardwerten und erzeugt sich eine dauerhafte Referenz-ID).

# Cloud-Endpunkte (Standard: die VoltPilot-Produktionsumgebung).
#VP_PORTAL_BASE_URL=https://voltpilot.de
#VP_MQTT_HOST=mqtt.voltpilot.de
#VP_MQTT_PORT=8883

# Geräte-Referenz (Edge-Referenz / Aufkleber-ID). Leer = automatisch erzeugt
# und in der lokalen Webansicht angezeigt.
#VP_REF=VP-XXXX-0001

# Batterie-Grenzen für die lokalen Guards (pro Anlage von VoltPilot gesetzt).
#VP_MAX_CHARGE_KW=50
#VP_MAX_DISCHARGE_KW=50
#VP_SOC_MIN_PCT=5
#VP_SOC_MAX_PCT=95

# Telemetrie-Puffer bei Cloud-Ausfall (Stunden, älteste Werte weichen zuerst).
#VP_BUFFER_HOURS=48

# Lokale Ports.
#VP_WEB_PORT=8484
#VP_NODERED_PORT=1881
#VP_BUS_PORT=1884

# Node-RED-Editor-Zugang (Service-Zugang für VoltPilot). PFLICHT: ohne ein
# eigenes, nicht-Standard-Passwort startet der Node-RED-Editor NICHT
# (fail closed - der frühere Standard "voltpilot" wird verweigert).
#VP_NODERED_USER=voltpilot
#VP_NODERED_PASSWORD=<eigenes-starkes-passwort>

# --- NUR ENTWICKLUNG: niemals auf Kundengeräten setzen -----------------------
# Feste Identität (überspringt das Enrollment) + Klartext-MQTT zur Cloud.
#VP_DEV_TENANT_ID=
#VP_DEV_SITE_ID=
#VP_DEV_DEVICE_ID=
#VP_DEV_CLOUD_URL=tcp://broker:1883
