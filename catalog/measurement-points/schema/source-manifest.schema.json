{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voltpilot.de/schemas/measurement-point-source-manifest/1.0",
  "title": "VoltPilot measurement-point source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter", "family", "id"],
        "properties": {
          "adapter": {"enum": ["deye", "sunspec", "goe", "shelly", "ocpp"]},
          "family": {"type": "string", "minLength": 1},
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string"},
          "path_pattern": {"type": "string"},
          "input_path": {"type": "string"},
          "raw_manifest_path": {"type": "string"},
          "extraction_spec_path": {"type": "string"},
          "annotations_path": {"type": "string"},
          "german_labels_path": {"type": "string"},
          "german_labels_url": {"type": "string", "pattern": "^https://"},
          "source_commit": {"type": ["string", "null"]},
          "source_revision": {"type": ["string", "null"]},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "extracted_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "raw_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "extraction_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "annotations_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "german_labels_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_url": {"type": "string", "pattern": "^https://"},
          "source_url_pattern": {"type": "string", "pattern": "^https://"},
          "models": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [{"type": "integer"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"adapter": {"const": "deye"}}},
            "then": {"required": ["input_path", "input_sha256", "path", "source_commit", "source_sha256", "source_url"]}
          },
          {
            "if": {"properties": {"adapter": {"const": "sunspec"}}},
            "then": {"required": ["models", "path_pattern", "source_commit", "source_url_pattern"]}
          },
          {
            "if": {"properties": {"adapter": {"const": "goe"}}},
            "then": {"required": ["german_labels_path", "german_labels_sha256", "german_labels_url", "path", "source_commit", "source_sha256", "source_url"]}
          },
          {
            "if": {"properties": {"adapter": {"const": "shelly"}}},
            "then": {"required": ["annotations_path", "annotations_sha256", "extracted_sha256", "extraction_spec_path", "extraction_spec_sha256", "path", "raw_manifest_path", "raw_manifest_sha256", "source_revision", "source_url"]}
          },
          {
            "if": {"properties": {"adapter": {"const": "ocpp"}}},
            "then": {"required": ["path", "source_commit", "source_sha256", "source_url"]}
          }
        ]
      }
    }
  }
}
