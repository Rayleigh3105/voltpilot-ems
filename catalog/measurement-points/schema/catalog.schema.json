{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voltpilot.de/schemas/measurement-point-catalog/1.0",
  "title": "VoltPilot measurement-point catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "deye_point_key_lock_sha256",
    "edge_min_version",
    "families",
    "points",
    "runtime_catalog_version",
    "schema_version",
    "source_manifest_sha256"
  ],
  "properties": {
    "catalog_version": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"},
    "deye_point_key_lock_sha256": {"$ref": "#/$defs/sha256"},
    "edge_min_version": {"type": "string", "minLength": 1},
    "runtime_catalog_version": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"},
    "schema_version": {"const": "1.0"},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["an_der_box", "family", "point_count", "rueckfall_ohne_box", "single_reader", "template_count"],
        "properties": {
          "an_der_box": {"type": "boolean", "description": "false = die Familie steht nur im Inhaltsstand und geht an keine Box (cataloglib.NOCH_NICHT_AN_DER_BOX, README „Familien noch nicht an der Box“)"},
          "family": {"type": "string", "minLength": 1},
          "point_count": {"type": "integer", "minimum": 1},
          "rueckfall_ohne_box": {
            "type": ["object", "null"],
            "description": "UEMS AP-15 IP-6: was ein Gerät dieser Familie tut, wenn seine Box schweigt, je Richtung (Vokabular geraete_rueckfall); null = VoltPilot steuert die Familie nicht. Cloud-Regel, geht nicht in den Box-Laufzeitkatalog.",
            "additionalProperties": false,
            "properties": {
              "einspeisung": {"$ref": "#/$defs/geraeteRueckfall"},
              "bezug": {"$ref": "#/$defs/geraeteRueckfall"}
            }
          },
          "single_reader": {"type": "boolean", "description": "Cloud-Regel: Geräte dieser Vorlage vertragen nie zwei gleichzeitig lesende Boxen; das Feld geht nicht in den Box-Laufzeitkatalog."},
          "template_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "points": {
      "type": "array",
      "items": {"$ref": "#/$defs/point"}
    }
  },
  "$defs": {
    "geraeteRueckfall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grund", "nach_s", "quelle", "rueckfall", "rueckfall_kw"],
      "properties": {
        "grund": {"type": "string", "minLength": 1},
        "nach_s": {"type": ["integer", "null"], "minimum": 0},
        "quelle": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["titel", "fassung", "stelle"],
          "properties": {
            "titel": {"type": "string", "minLength": 1},
            "fassung": {"type": "string", "minLength": 1},
            "stelle": {"type": "string", "minLength": 1}
          }
        },
        "rueckfall": {"enum": ["haelt_letzten_wert", "faellt_auf_wert", "laeuft_frei", "unbekannt"]},
        "rueckfall_kw": {"type": ["number", "null"], "minimum": 0}
      },
      "if": {"properties": {"rueckfall": {"const": "unbekannt"}}},
      "then": {"properties": {"quelle": {"type": "null"}, "rueckfall_kw": {"type": "null"}, "nach_s": {"type": "null"}}}
    },
    "nullableString": {"type": ["string", "null"]},
    "nullableBoolean": {"type": ["boolean", "null"]},
    "nullableInteger": {"type": ["integer", "null"], "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["none", "factor", "divisor", "conditional_factor", "sunssf", "protocol_value", "unknown"]},
        "value": {},
        "point": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"enum": ["factor", "divisor", "conditional_factor"]}}}, "then": {"required": ["value"]}},
        {"if": {"properties": {"kind": {"const": "sunssf"}}}, "then": {"required": ["point"]}}
      ]
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "retrieved_date", "sha256", "url"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "retrieved_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "url": {"type": "string", "pattern": "^https://"}
      }
    },
    "modbusAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "registers", "width_words"],
      "properties": {
        "kind": {"enum": ["modbus_holding", "modbus_input"]},
        "registers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0, "maximum": 65535}
        },
        "width_words": {"type": "integer", "minimum": 1}
      }
    },
    "sunspecAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "kind", "model_id", "offset_words", "width_words"],
      "properties": {
        "base": {"const": "discovered"},
        "kind": {"const": "sunspec_relative"},
        "model_id": {"type": "integer", "minimum": 1},
        "offset_words": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "string", "pattern": "^[0-9]+\\+index\\*[1-9][0-9]*\\+[0-9]+$"}
          ]
        },
        "width_words": {"type": "integer", "minimum": 1}
      }
    },
    "registerbildAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "kind", "offset_words", "width_words"],
      "description": "Adresse im VoltPilot-Registerbild WAGO v1: Basisadresse, Funktionscode und Wortfolge sind Parameter je Anlage (wago-registerbild.md §2); der Offset zählt Kopf + index · Karten-Block + Feld.",
      "properties": {
        "base": {"const": "parameter"},
        "kind": {"const": "registerbild_relative"},
        "offset_words": {"type": "string", "pattern": "^[0-9]+\\+index\\*[1-9][0-9]*\\+[0-9]+$"},
        "width_words": {"type": "integer", "minimum": 1}
      }
    },
    "angabe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["art"],
      "description": "Herkunft EINER Zahl, wie docs/contracts/v2/wago-registerbild-vectors.json: festlegung (Vertrag) · handbuch (nur für die Artikel in gilt_fuer) · zu erheben (wo).",
      "properties": {
        "art": {"enum": ["festlegung", "handbuch", "zu erheben"]},
        "fundstelle": {"type": "string", "minLength": 1},
        "gilt_fuer": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{3}-[0-9]{3}$"}},
        "wert": {"type": "string", "minLength": 1},
        "wo": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"art": {"const": "festlegung"}}}, "then": {"required": ["fundstelle"]}},
        {"if": {"properties": {"art": {"const": "handbuch"}}}, "then": {"required": ["fundstelle", "gilt_fuer"]}},
        {"if": {"properties": {"art": {"const": "zu erheben"}}}, "then": {"required": ["wo"]}}
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "aggregation_kind",
        "catalog_version",
        "default_cadence_s",
        "direction",
        "edge_min_version",
        "endian",
        "family",
        "group",
        "label_de",
        "label_source",
        "long_term_cadence_s",
        "min_cadence_s",
        "point_key",
        "point_key_aliases",
        "poll_group",
        "quantity",
        "readable",
        "scale",
        "selector",
        "semantic_status",
        "signed",
        "source_commit",
        "source_kind",
        "source_revision",
        "source_sha256",
        "source_url",
        "unit",
        "value_type",
        "width_bits"
      ],
      "properties": {
        "access": {"type": "string"},
        "address": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/modbusAddress"}, {"$ref": "#/$defs/sunspecAddress"}, {"$ref": "#/$defs/registerbildAddress"}]},
        "aggregation_kind": {"enum": ["gauge", "counter", "state", "event", "bitfield", "text", "none"]},
        "angaben": {
          "type": "object",
          "additionalProperties": false,
          "description": "Herkunft je Zahl (UEMS AP-05 IP-4). Eine Handbuch-Angabe gilt nur für die Artikel in gilt_fuer und wird nie von einer anderen Karte geerbt; was zu erheben ist, steht nicht als Tatsache im Punkt (value_type/scale unknown, keine Einheit, kein range).",
          "properties": {
            "address": {"$ref": "#/$defs/angabe"},
            "met_id": {"$ref": "#/$defs/angabe"},
            "range": {"$ref": "#/$defs/angabe"},
            "scale": {"$ref": "#/$defs/angabe"},
            "value_type": {"$ref": "#/$defs/angabe"}
          }
        },
        "catalog_version": {"type": "string", "minLength": 1},
        "decoder": {"type": "object"},
        "default_cadence_s": {"$ref": "#/$defs/nullableInteger"},
        "derived_from": {"type": "array", "items": {"type": "string"}},
        "direction": {"enum": ["charge", "charge_discharge", "discharge", "export", "generation", "import", "import_export", "none", null]},
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contexts", "formats", "locations", "phases", "units"],
          "properties": {
            "contexts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "formats": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "locations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "phases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "units": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "dynamic": {"type": "boolean"},
        "edge_min_version": {"type": "string", "minLength": 1},
        "endian": {"enum": ["big", "word_little_byte_big", null]},
        "family": {"type": "string", "minLength": 1},
        "group": {"type": "string", "minLength": 1},
        "label_de": {"$ref": "#/$defs/nullableString"},
        "label_source": {"$ref": "#/$defs/nullableString"},
        "label_source_sha256": {"$ref": "#/$defs/sha256"},
        "label_source_url": {"type": "string", "pattern": "^https://"},
        "laeuft_ueber": {
          "type": "boolean",
          "description": "Nur am Zähler und nur mit wertebereich_modul: true = der Stand beginnt bei wertebereich_modul wirklich wieder bei 0, false = belegt kein Überlauf. Fehlt das Feld, ist nichts deklariert."
        },
        "long_term_cadence_s": {"$ref": "#/$defs/nullableInteger"},
        "mandatory": {"type": "boolean"},
        "min_cadence_s": {"$ref": "#/$defs/nullableInteger"},
        "optional": {"type": "boolean"},
        "point_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._*\\[\\]@-]*$"},
        "point_key_aliases": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._*\\[\\]@-]*$"},
          "uniqueItems": true
        },
        "point_key_template": {"type": "boolean"},
        "poll_group": {"type": "string", "minLength": 1},
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["invalid", "max", "min"],
          "description": "Wertebereich des ROHwerts vor scale (UEMS AP-05 IP-5): min … max ist ein Wert, invalid heißt „kein Messwert“ (WAGO: der größte Wert des Datentyps). Fehlt das Feld, ist nichts deklariert — nie null.",
          "properties": {
            "invalid": {"type": "integer"},
            "max": {"type": "integer"},
            "min": {"type": "integer"}
          }
        },
        "quantity": {"enum": ["active_energy", "active_power", "apparent_energy", "apparent_power", "current", "energy_capacity", "frequency", "power_factor", "reactive_energy", "reactive_power", "soc", "temperature", "voltage", null]},
        "readable": {"type": "boolean"},
        "recommended": {"type": "boolean"},
        "scale": {"$ref": "#/$defs/scale"},
        "selector": {"type": "string", "minLength": 1},
        "semantic_status": {"enum": ["known", "vendor_label_only", "unknown"]},
        "signed": {"$ref": "#/$defs/nullableBoolean"},
        "source_commit": {"$ref": "#/$defs/nullableString"},
        "source_key_raw": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["modbus_holding", "modbus_input", "sunspec_model", "http_api_key", "rest_json", "rpc_json", "ocpp_sampled_value", "wago_registerbild"]},
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceEvidence"},
          "uniqueItems": true
        },
        "source_revision": {"$ref": "#/$defs/nullableString"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_url": {"type": "string", "pattern": "^https://"},
        "unit": {"$ref": "#/$defs/nullableString"},
        "value_type": {"type": "string", "minLength": 1},
        "wertebereich_modul": {
          "type": "integer",
          "minimum": 2,
          "description": "Nur am Zähler: bei diesem Stand beginnt der Zähler wieder bei 0 (z. B. 65536 für einen 16-Bit-Impulszähler). Fehlt das Feld, ist nichts deklariert — nie null, nie ein Vorgabewert."
        },
        "width_bits": {"$ref": "#/$defs/nullableInteger"}
      },
      "allOf": [
        {"if": {"required": ["laeuft_ueber"]}, "then": {"required": ["wertebereich_modul"]}},
        {"if": {"required": ["laeuft_ueber"]}, "then": {"properties": {"aggregation_kind": {"const": "counter"}}}},
        {"if": {"required": ["wertebereich_modul"]}, "then": {"properties": {"aggregation_kind": {"const": "counter"}}}}
      ]
    }
  }
}
