{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voltpilot.de/schemas/control-profile-source-manifest/1.0",
  "title": "VoltPilot Quellenmanifest der Steuerprofile",
  "description": "Jede Quelle, auf die ein Profil oder eine Zelle verweist, mit Stand und Art. Repo-Quellen nennen Pfade, die im Checkout existieren müssen.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "quellen"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "quellen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "titel", "art", "stand", "ort"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "titel": {"type": "string", "minLength": 1},
          "art": {
            "description": "hersteller = Herstellerdokument · feld = Integration/Forum · eigen = eigener Scout-Bericht oder Messung · repo = Code in diesem Repo",
            "enum": ["hersteller", "feld", "eigen", "repo"]
          },
          "stand": {"type": "string", "minLength": 1},
          "ort": {"type": "string", "minLength": 1},
          "pfade": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "if": {"properties": {"art": {"const": "repo"}}},
        "then": {"required": ["pfade"]}
      }
    }
  }
}
