
config vp-edge-light 'main'
	# 1 = Dienst aktiv. Erst einschalten, wenn die bestaetigte Fassung im
	# Flash liegt (install.sh erledigt das).
	option enabled '0'

	option arch 'mipsle'

	# Die bestaetigte Fassung im Flash: <local_dir>/vp-edge-light-linux-<arch>.gz
	# und .sha256 (Zeile 1: Pruefsumme des ungepackten Programms, Zeile 2:
	# der gepackten Kopie - mit ihr laedt der Loader genau diese Fassung aus
	# dem Portal nach, falls die Kopie beim Update unvollstaendig blieb).
	# Neue Fassungen kommen signiert ueber das Portal (Edge-Updates), nie
	# ueber eine Download-Adresse; base_url ist abgeschafft und wird ignoriert.
	option local_dir '/usr/share/vp-edge-light'

	# Wache einer neuen Fassung in der Probe (wie die Docker-Box): Frist in s
	# fuer einen gruenen Selbsttest mit Cloud, hoechstens so viele Starts,
	# Frist in s fuer den Probestart `version`.
	option probe_frist '600'
	option probe_starts '3'
	option version_frist '5'

	# Dauerhafter Zustand (Flash) und fluechtiger Zustand (RAM).
	option data_dir '/etc/vp-edge-light'
	option ram_dir '/tmp/vp-edge-light'

	option portal_url 'https://portal.voltpilot.de'
	# Lokale Web-App. LuCI bzw. die GL-Oberflaeche belegen Port 80/443.
	option web_addr ':8484'
	option bus_addr '127.0.0.1:1883'

	# Weiches Speicherlimit fuer Go (128 MB RAM teilen sich Router, WireGuard,
	# das Programm im tmpfs und der Prozess).
	option gomemlimit '48MiB'
	# Speicherschwelle des Loaders vor Entpacken/Download: Groesse des
	# entpackten Programms (groesse-Zeile der Pruefsummen-Datei bzw.
	# kandidat.json) plus prozess_reserve_kb (gemessene VmRSS 16-18 MB plus
	# ~2 MB fuers Entpacken). Nur wenn die Groesse unbekannt ist, gilt
	# min_free_kb pauschal.
	option min_free_kb '40000'
	option prozess_reserve_kb '20000'
	# Bei Speichernot trifft der Kernel zuerst das Programm, nie WireGuard/SSH.
	option oom_score_adj '800'

	# Weitere Einstellungen der Box (wie in edge-app/.env.example), z. B.:
	# list env 'VP_REF=VP-1234'
	# list env 'VP_CONSUMER_CONTROL_ENABLED=true'
