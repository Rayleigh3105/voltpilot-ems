#!/bin/sh /etc/rc.common
# Edge Light als procd-Dienst. Der Loader laedt das Programm in den RAM und
# startet es; endet es (Absturz, Update-Neustart), startet procd den Loader
# nach 10 s erneut - unbegrenzt oft.

START=99
STOP=10
USE_PROCD=1

start_service() {
	config_load vp-edge-light
	local enabled
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/libexec/vp-edge-light/boot.sh
	# respawn: Schwelle 3600 s, Pause 10 s, Versuche 0 = unbegrenzt
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 15
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger vp-edge-light
}
