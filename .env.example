# =============================================================================
# Voltpilot-EMS - local development environment
# -----------------------------------------------------------------------------
# Copy to `.env` (`cp .env.example .env`) before running `docker compose up`.
# All secrets below are DEV-ONLY defaults. NEVER use these in staging/prod.
# =============================================================================

# ---- Global ----
COMPOSE_PROJECT_NAME=voltpilot

# ---- TimescaleDB / PostgreSQL -----------------------------------------------
# One Postgres instance holds both timeseries (hypertables) and master data.
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=voltpilot
POSTGRES_USER=voltpilot
# DEV-ONLY password. Do not reuse.
POSTGRES_PASSWORD=voltpilot_dev_pw
# JDBC URL used by the JVM services (host is the compose service name).
POSTGRES_JDBC_URL=jdbc:postgresql://timescaledb:5432/voltpilot

# ---- EMQX (MQTT broker) -----------------------------------------------------
EMQX_MQTT_PORT=1883
EMQX_MQTT_TLS_PORT=8883
EMQX_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083
# DEV-ONLY dashboard credentials.
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=voltpilot_dev_pw

# ---- Redpanda (Kafka API event log) -----------------------------------------
REDPANDA_KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644
REDPANDA_CONSOLE_PORT=8080
# Bootstrap servers as seen from inside the compose network.
REDPANDA_BOOTSTRAP_SERVERS=redpanda:29092
# The MVP raw telemetry topic (created by the redpanda-init one-shot).
REDPANDA_TELEMETRY_TOPIC=telemetry.raw
REDPANDA_TELEMETRY_PARTITIONS=3

# ---- Keycloak (OIDC) --------------------------------------------------------
KEYCLOAK_PORT=8081
KEYCLOAK_REALM=voltpilot
# DEV-ONLY admin credentials.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=voltpilot_dev_pw
# OIDC clients imported by the dev realm.
KEYCLOAK_API_CLIENT_ID=voltpilot-api
KEYCLOAK_FRONTEND_CLIENT_ID=voltpilot-frontend
# Issuer URI used by the API to validate tokens (compose-internal hostname).
OIDC_ISSUER_URI=http://keycloak:8080/realms/voltpilot

# ---- Portal API (Spring Boot) -----------------------------------------------
API_PORT=8090

# ---- Ingest / Writer service tuning -----------------------------------------
MQTT_TELEMETRY_TOPIC_FILTER=ems/+/+/+/telemetry
