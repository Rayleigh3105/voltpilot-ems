# =============================================================================
# Voltpilot-EMS - local development environment
# -----------------------------------------------------------------------------
# Copy to `.env` (`cp .env.example .env`) before running `docker compose up`.
# All secrets below are DEV-ONLY defaults. NEVER use these in staging/prod.
# =============================================================================

# ---- Global ----
COMPOSE_PROJECT_NAME=voltpilot

# ---- TimescaleDB / PostgreSQL -----------------------------------------------
# One Postgres instance holds both timeseries (hypertables) and master data.
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=voltpilot
POSTGRES_USER=voltpilot
# DEV-ONLY password. Do not reuse.
POSTGRES_PASSWORD=voltpilot_dev_pw
# JDBC URL used by the JVM services (host is the compose service name).
POSTGRES_JDBC_URL=jdbc:postgresql://timescaledb:5432/voltpilot

# ---- EMQX (MQTT broker) -----------------------------------------------------
EMQX_MQTT_PORT=1883
EMQX_MQTT_TLS_PORT=8883
EMQX_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083
# DEV-ONLY dashboard credentials.
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=voltpilot_dev_pw

# ---- Secure broker (docker-compose.prod.yml, real remote devices) -----------
# Only used by the SECURE overlay; the default dev stack ignores these.
# Public FQDN + IP of your broker host (goes into the server cert SAN and the
# device connection params). See docs/connect-a-device.md.
MQTT_BROKER_DOMAIN=mqtt.example.com
MQTT_BROKER_PUBLIC_IP=203.0.113.10
# Username the INTERNAL backbone services (ingest/writer) use on 1883 so the
# ACL grants them full ems/# access (devices are confined to their own path).
MQTT_INTERNAL_USERNAME=vp-internal

# ---- Redpanda (Kafka API event log) -----------------------------------------
REDPANDA_KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644
REDPANDA_CONSOLE_PORT=8080
# Bootstrap servers as seen from inside the compose network.
REDPANDA_BOOTSTRAP_SERVERS=redpanda:29092
# The MVP raw telemetry topic (created by the redpanda-init one-shot).
REDPANDA_TELEMETRY_TOPIC=telemetry.raw
REDPANDA_TELEMETRY_PARTITIONS=3

# ---- Keycloak (OIDC) --------------------------------------------------------
KEYCLOAK_PORT=8081
KEYCLOAK_REALM=voltpilot
# DEV-ONLY admin credentials.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=voltpilot_dev_pw
# OIDC clients imported by the dev realm.
KEYCLOAK_API_CLIENT_ID=voltpilot-api
KEYCLOAK_FRONTEND_CLIENT_ID=voltpilot-frontend
# Secret of the confidential voltpilot-api client. Its service account holds the
# realm-management roles the platform-admin API uses to provision customer users
# via the Keycloak Admin REST API. DEV-ONLY value; matches the realm import.
KEYCLOAK_API_CLIENT_SECRET=voltpilot-api-dev-secret
# Compose-internal Keycloak URL the API uses for Admin REST calls (no realm
# suffix). Decoupled from the browser-facing OIDC_ISSUER_URI, same as the JWKS.
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
# Pins Keycloak's public URL so every token carries a stable issuer that both
# the browser and the API agree on (the issuer-trap fix).
KC_HOSTNAME=http://localhost:8081
# Issuer the API validates (browser-facing URL, matches KC_HOSTNAME).
OIDC_ISSUER_URI=http://localhost:8081/realms/voltpilot
# JWKS endpoint the API fetches keys from (compose-internal hostname, reachable
# from inside the network without resolving localhost:8081).
OIDC_JWK_SET_URI=http://keycloak:8080/realms/voltpilot/protocol/openid-connect/certs

# ---- Portal API (Spring Boot) -----------------------------------------------
API_PORT=8090
# The API connects as this NON-privileged role so Postgres RLS is enforced;
# Flyway migrates as POSTGRES_USER (superuser) and creates this role.
# DEV-ONLY password. Do not reuse.
APP_DB_USER=voltpilot_app
APP_DB_PASSWORD=voltpilot_app_dev_pw
# Dedicated cross-tenant role for the platform-admin API only (BYPASSRLS,
# created by Flyway V4). Customer endpoints never use it; RLS stays enforced on
# the app role above. DEV-ONLY password. Do not reuse.
ADMIN_DB_USER=voltpilot_admin
ADMIN_DB_PASSWORD=voltpilot_admin_dev_pw
# Browser origin(s) allowed to call the API (the Vite portal).
VOLTPILOT_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Stable local-only pepper for opaque OCPP idTag references. Production uses a
# generated secret; changing it breaks reference continuity but leaks no tags.
VOLTPILOT_OCPP_PRIVACY_PEPPER=voltpilot-local-ocpp-privacy

# ---- Web portal (React / Vite) ----------------------------------------------
# Consumed by the frontend at build/dev time (Vite reads VITE_* vars).
VITE_API_BASE=http://localhost:8090
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=voltpilot
VITE_KEYCLOAK_CLIENT_ID=voltpilot-frontend

# ---- Ingest / Writer service tuning -----------------------------------------
# The live ingest pipe (ingest + timescale-writer) runs in the compose `edge`
# profile (EMQX -> ingest -> Redpanda -> writer -> TimescaleDB). It reuses the
# vars above: REDPANDA_BOOTSTRAP_SERVERS / REDPANDA_TELEMETRY_TOPIC (Redpanda),
# POSTGRES_JDBC_URL + APP_DB_USER/APP_DB_PASSWORD (writer, RLS-scoped app role),
# and reaches EMQX in-cluster at emqx:1883. No host ports are published for
# ingest/writer (health is probed in-container).
MQTT_TELEMETRY_TOPIC_FILTER=ems/+/+/+/telemetry

# ---- Edge (Node-RED + SunSpec Modbus sim) -----------------------------------
# Only started with the compose `edge` profile (not the default `up`):
#   docker compose --profile edge up -d --build edge-sim edge-nodered
# Host-side debug ports; on the compose network the edge always uses the
# in-cluster names emqx:1883 and edge-sim:502 regardless of these.
EDGE_SIM_PORT=15020
EDGE_NODERED_PORT=1880
# Device identity the edge stamps onto telemetry / uses for its MQTT topics.
# Defaults mirror the dev seed in infra/local/timescale/01-init.sql.
VP_TENANT_ID=00000000-0000-0000-0000-000000000001
VP_SITE_ID=00000000-0000-0000-0000-000000000002
VP_DEVICE_ID=00000000-0000-0000-0000-000000000003

# ---- Market data / ENTSO-E Transparency (day-ahead prices) ------------------
# Provider-agnostic day-ahead price adapter (services/market-data). ENTSO-E is
# the first implementation; a commercial provider is swappable behind the port.
#
# ENTSOE_SECURITY_TOKEN is a CAPTAIN-PROVIDED SECRET and is intentionally left
# blank here. Obtain it: register at https://transparency.entsoe.eu, then email
# transparency@entsoe.eu with subject "Restful API access" to have the API role
# added; the token appears under "My Account Settings" -> "Web Api Security
# Token". Fixture-based tests do NOT need it; only a real live fetch does.
ENTSOE_SECURITY_TOKEN=
ENTSOE_BASE_URL=https://web-api.tp.entsoe.eu/api
ENTSOE_TIMEOUT_SECONDS=30
# Default bidding zone used by `fetch` when --zone is not passed - the
# containerised cron job reads it from here (DE-LU first; AT/CH supported).
MARKET_DATA_ZONE=DE-LU

# ---- Marktstammdatenregister (MaStR, "Anlage verknüpfen") --------------------
# OPTIONAL captain-provided Webdienst credentials (services/api). Blank - the
# default - means MaStR lookups use the KEYLESS public JSON backend, which works
# for dev and small volumes out of the box. The captain's one-time registration
# (MaStR account -> Marktakteur -> Webdienstnutzer, free) yields the API key +
# Marktakteur number; setting BOTH switches lookups to the official SOAP
# webservice. Never commit a real key. Tests never need one (recorded fixtures).
MASTR_API_KEY=
MASTR_MARKTAKTEUR_NUMMER=

# ---- KEYLESS data feeds (energy-charts.info + Open-Meteo) --------------------
# The `feeds` compose profile runs two long-running collectors that need NO API
# key, so real DE-LU day-ahead prices (15-min) and site weather flow with no
# captain secret:
#   docker compose --profile feeds up -d --build market-data weather-collector
#
# Day-ahead price source: `energy-charts` (Fraunhofer ISE, KEYLESS, the default)
# or `entsoe` (needs ENTSOE_SECURITY_TOKEN above). energy-charts publishes the
# next day ~13:00; the collector's `serve` mode refreshes today+tomorrow on
# startup then every MARKET_DATA_REFRESH_SECONDS - and, coverage-aware, polls
# every MARKET_DATA_FAST_REFRESH_SECONDS once Berlin local time passes
# MARKET_DATA_PUBLICATION_HOUR (decimal hours; 12.75 = 12:45) while tomorrow's
# prices are still missing, until they land (bounded at midnight).
MARKET_DATA_SOURCE=energy-charts
MARKET_DATA_REFRESH_SECONDS=21600
MARKET_DATA_FAST_REFRESH_SECONDS=900
MARKET_DATA_PUBLICATION_HOUR=12.75
ENERGY_CHARTS_BASE_URL=https://api.energy-charts.info

# Weather forecast: Open-Meteo (EU-hosted, KEYLESS). Fetched per site (by the
# site's latitude/longitude) for WEATHER_FORECAST_DAYS days, refreshed every
# WEATHER_REFRESH_SECONDS. Temperature, cloud cover and shortwave/GHI radiation
# feed the portal weather panel and the PV forecast.
WEATHER_FORECAST_DAYS=3
WEATHER_REFRESH_SECONDS=10800
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# ---- Shadow-mode forecasting (docs/forecasting.md) ---------------------------
# The `feeds` profile also runs the forecast collector: every 15 min it runs the
# BASELINE forecast models plus the self-gated XGBoost challengers for every
# site, persists all predictions model-tagged, and once per Berlin day retrains
# the challengers + evaluates every model against the measured telemetry
# (forecast_accuracy / plan_accuracy; the portal's "Prognosequalität" page).
#
# The optimizer consumes ONLY the ACTIVE model per kind. Promotion of a
# challenger is a deliberate flip of these two variables (they feed the
# forecast-collector, the optimizer AND the api's display) - NEVER automatic:
#   load models: load-persistence (baseline/default) | load-xgb
#   pv models:   pv-physical (baseline/default)      | pv-residual-xgb
VOLTPILOT_ACTIVE_LOAD_MODEL=load-persistence
VOLTPILOT_ACTIVE_PV_MODEL=pv-physical
# Collector cadence + challenger self-gate (full telemetry days before training).
FORECAST_INTERVAL_SECONDS=900
FORECAST_HORIZON_HOURS=24

# ---- Optimizer economics + telemetry freshness (redesign Stage 1) ------------
# Battery wear cost in ct per kWh CYCLED (LFP default: ~250 EUR/kWh replacement
# / ~6,000 cycles; derivation in services/optimization config.py). Per-asset
# override: asset.wear_cost_ct_per_kwh (NULL = this default).
OPTIMIZER_WEAR_COST_CT_PER_KWH=4.0
# Telemetry readings older than these windows are ignored: a stale observed
# paragraph-14a grid_limit_kw means NO active limit, a stale soc_pct falls back
# to the 50% default.
OPTIMIZER_GRID_LIMIT_MAX_AGE_MINUTES=60
OPTIMIZER_SOC_MAX_AGE_MINUTES=120
# Structured Bezugspreis: price dynamisch-without-Aufschlag / ohne sites with
# the researched default supply components (report vp-nacht-bezug-e7 Teil 2,
# ~15.7 ct netto + 19% USt) instead of bare spot when NO site_supply_price
# row is maintained. Default ON (captain decision 2026-07-29); set to false to
# opt out (the Notbremse) and keep bare-spot legacy pricing.
OPTIMIZER_DEFAULT_SUPPLY_COMPONENTS=true
VOLTPILOT_ML_MIN_DAYS=21

# --- Verbrauchssteuerung (steuerbare Verbraucher, §19 Inkrement 5) ------------
# ALL FOUR default OFF: with them off a plant behaves byte-for-byte as before
# the feature; the only visible change is the new (honestly-labeled) display
# surfaces. Arm them per plant per docs/verbrauchssteuerung-betrieb.md.
# api: the master switch of the activation surface (off = "Steuerung noch nicht
# aktiviert", and a manual override is recorded + audited but not pushed).
VOLTPILOT_CONSUMER_CONTROL_ENABLED=false
# api: additionally gates the policy compile+rollout half.
VOLTPILOT_CONSUMER_POLICY_COMPILER_ENABLED=false
# optimization: the master gate for co-optimizing consumers into the v2 shadow
# plan (off = consumer-less v2 plan, byte-identical to the pre-Inkrement-2 shadow).
OPTIMIZER_CONTROLLABLE_LOADS_ENABLED=false
# edge (edge-app/.env): the consumer-control switch on the device, distinct from
# VP_CONTROL_ENABLED. Off = the edge never issues a consumer command.
VP_CONSUMER_CONTROL_ENABLED=false
