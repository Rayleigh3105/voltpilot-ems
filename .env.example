# =============================================================================
# Voltpilot-EMS - local development environment
# -----------------------------------------------------------------------------
# Copy to `.env` (`cp .env.example .env`) before running `docker compose up`.
# All secrets below are DEV-ONLY defaults. NEVER use these in staging/prod.
# =============================================================================

# ---- Global ----
COMPOSE_PROJECT_NAME=voltpilot

# ---- TimescaleDB / PostgreSQL -----------------------------------------------
# One Postgres instance holds both timeseries (hypertables) and master data.
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=voltpilot
POSTGRES_USER=voltpilot
# DEV-ONLY password. Do not reuse.
POSTGRES_PASSWORD=voltpilot_dev_pw
# JDBC URL used by the JVM services (host is the compose service name).
POSTGRES_JDBC_URL=jdbc:postgresql://timescaledb:5432/voltpilot

# ---- EMQX (MQTT broker) -----------------------------------------------------
EMQX_MQTT_PORT=1883
EMQX_MQTT_TLS_PORT=8883
EMQX_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083
# DEV-ONLY dashboard credentials.
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=voltpilot_dev_pw

# ---- Redpanda (Kafka API event log) -----------------------------------------
REDPANDA_KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644
REDPANDA_CONSOLE_PORT=8080
# Bootstrap servers as seen from inside the compose network.
REDPANDA_BOOTSTRAP_SERVERS=redpanda:29092
# The MVP raw telemetry topic (created by the redpanda-init one-shot).
REDPANDA_TELEMETRY_TOPIC=telemetry.raw
REDPANDA_TELEMETRY_PARTITIONS=3

# ---- Keycloak (OIDC) --------------------------------------------------------
KEYCLOAK_PORT=8081
KEYCLOAK_REALM=voltpilot
# DEV-ONLY admin credentials.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=voltpilot_dev_pw
# OIDC clients imported by the dev realm.
KEYCLOAK_API_CLIENT_ID=voltpilot-api
KEYCLOAK_FRONTEND_CLIENT_ID=voltpilot-frontend
# Pins Keycloak's public URL so every token carries a stable issuer that both
# the browser and the API agree on (the issuer-trap fix).
KC_HOSTNAME=http://localhost:8081
# Issuer the API validates (browser-facing URL, matches KC_HOSTNAME).
OIDC_ISSUER_URI=http://localhost:8081/realms/voltpilot
# JWKS endpoint the API fetches keys from (compose-internal hostname, reachable
# from inside the network without resolving localhost:8081).
OIDC_JWK_SET_URI=http://keycloak:8080/realms/voltpilot/protocol/openid-connect/certs

# ---- Portal API (Spring Boot) -----------------------------------------------
API_PORT=8090
# The API connects as this NON-privileged role so Postgres RLS is enforced;
# Flyway migrates as POSTGRES_USER (superuser) and creates this role.
# DEV-ONLY password. Do not reuse.
APP_DB_USER=voltpilot_app
APP_DB_PASSWORD=voltpilot_app_dev_pw
# Browser origin(s) allowed to call the API (the Vite portal).
VOLTPILOT_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Web portal (React / Vite) ----------------------------------------------
# Consumed by the frontend at build/dev time (Vite reads VITE_* vars).
VITE_API_BASE=http://localhost:8090
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=voltpilot
VITE_KEYCLOAK_CLIENT_ID=voltpilot-frontend

# ---- Ingest / Writer service tuning -----------------------------------------
MQTT_TELEMETRY_TOPIC_FILTER=ems/+/+/+/telemetry

# ---- Edge (Node-RED + SunSpec Modbus sim) -----------------------------------
# Only started with the compose `edge` profile (not the default `up`):
#   docker compose --profile edge up -d --build edge-sim edge-nodered
# Host-side debug ports; on the compose network the edge always uses the
# in-cluster names emqx:1883 and edge-sim:502 regardless of these.
EDGE_SIM_PORT=15020
EDGE_NODERED_PORT=1880
# Device identity the edge stamps onto telemetry / uses for its MQTT topics.
# Defaults mirror the dev seed in infra/local/timescale/01-init.sql.
VP_TENANT_ID=00000000-0000-0000-0000-000000000001
VP_SITE_ID=00000000-0000-0000-0000-000000000002
VP_DEVICE_ID=00000000-0000-0000-0000-000000000003

# ---- Market data / ENTSO-E Transparency (day-ahead prices) ------------------
# Provider-agnostic day-ahead price adapter (services/market-data). ENTSO-E is
# the first implementation; a commercial provider is swappable behind the port.
#
# ENTSOE_SECURITY_TOKEN is a CAPTAIN-PROVIDED SECRET and is intentionally left
# blank here. Obtain it: register at https://transparency.entsoe.eu, then email
# transparency@entsoe.eu with subject "Restful API access" to have the API role
# added; the token appears under "My Account Settings" -> "Web Api Security
# Token". Fixture-based tests do NOT need it; only a real live fetch does.
ENTSOE_SECURITY_TOKEN=
ENTSOE_BASE_URL=https://web-api.tp.entsoe.eu/api
ENTSOE_TIMEOUT_SECONDS=30
# Default bidding zone used by `fetch` when --zone is not passed - the
# containerised cron job reads it from here (DE-LU first; AT/CH supported).
MARKET_DATA_ZONE=DE-LU
