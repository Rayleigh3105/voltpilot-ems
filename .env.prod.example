# =============================================================================
# Voltpilot-EMS - PRODUCTION environment (single-VPS deploy)
# -----------------------------------------------------------------------------
# Copy to /srv/docker/voltpilot/.env on the VPS, then fill in the secrets below.
# `docker compose` reads it automatically; the deploy workflow overrides
# IMAGE_TAG per rollout. NEVER commit the real .env.
#
# This is the PROD template - distinct from the repo-root .env.example, which is
# the local DEV stack. Every secret marked REQUIRED aborts the deploy (${VAR:?})
# if left blank.
# =============================================================================

# --- Public address ----------------------------------------------------------
# FQDN your external reverse proxy (Nginx Proxy Manager or Caddy, on another
# host) serves over HTTPS (TLS terminated there). Drives the Keycloak
# issuer/realm origins and bakes into the SPA build (VITE_KEYCLOAK_URL) -
# changing it means rebuilding the frontend image.
DOMAIN=voltpilot.example.com
# Plain-HTTP port on THIS server the external proxy forwards to. Firewall it so
# only the proxy host can reach it (it is plain HTTP).
APP_PORT=8080

# --- Secrets (REQUIRED) - the deploy aborts if any is blank -------------------
# Generate each with:  openssl rand -base64 24
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Cross-tenant admin DB role (voltpilot_admin, BYPASSRLS - platform-admin API).
ADMIN_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
# Keycloak ADMIN CONSOLE bootstrap user (https://${DOMAIN}/auth/admin).
KEYCLOAK_ADMIN_PASSWORD=
# PORTAL-Admin user `admin` seeded into the voltpilot realm (the in-app admin
# console for tenants + customer users). Distinct from KEYCLOAK_ADMIN_PASSWORD.
VP_PORTAL_ADMIN_PASSWORD=
# Confidential OIDC client secret for voltpilot-api (baked into the realm import).
#   openssl rand -base64 24
VP_API_CLIENT_SECRET=
# EMQX Erlang distribution cookie + dashboard password.
#   openssl rand -hex 16
EMQX_NODE_COOKIE=
#   openssl rand -base64 24
EMQX_DASHBOARD_PASSWORD=

# --- Optional non-secret overrides (sensible defaults shown) ------------------
POSTGRES_DB=voltpilot
POSTGRES_USER=voltpilot
APP_DB_USER=voltpilot_app
KEYCLOAK_ADMIN=admin
EMQX_DASHBOARD_USER=admin

# Spring profile for the api. BLANK (the default here) is the PRODUCTION setting:
# only db/migration (prod-safe core) runs, so no demo tenants/telemetry land on a
# real DB. Set to `local` ONLY for a throwaway demo VM - it additionally runs the
# db/dev seed migrations (two demo tenants + demo/demo realm user). DEV-ONLY: a
# real launch keeps this blank. (Switching a `local` VM back to blank later boots
# cleanly thanks to the api's ignore-migration-patterns "*:missing" - docs/deploy.md.)
SPRING_PROFILES_ACTIVE=

# Public self-service registration (tenant + login in one step, portal "Konto
# erstellen"). On by default; set false to run a closed platform where only
# Portal-Admins create customer accounts.
VOLTPILOT_REGISTRATION_ENABLED=true
# Registration abuse guard (sliding window). The client address is taken from
# the X-Forwarded-For proxy chain; TRUSTED_PROXIES is the number of own proxy
# hops in front of the api (default 2: external reverse proxy -> frontend
# nginx). Change it only if you add/remove a proxy layer. Other defaults are
# sensible - uncomment only to tune.
#VOLTPILOT_REGISTRATION_RATE_LIMIT_TRUSTED_PROXIES=2
#VOLTPILOT_REGISTRATION_RATE_LIMIT_PER_CLIENT_MAX=10
#VOLTPILOT_REGISTRATION_RATE_LIMIT_GLOBAL_MAX=100
#VOLTPILOT_REGISTRATION_RATE_LIMIT_WINDOW=PT1H

# --- First-boot device enrollment (kinderleicht mTLS onboarding) --------------
# A fresh edge device knowing only its ref + the portal URL uploads a CSR and
# polls https://${DOMAIN}/api/v1/enrollment/... for its device certificate; the
# api signs it with the device CA once the ref is claimed in the portal (see
# docs/connect-a-device.md). Requires the CA working dir on this VM (created by
# `tools/pki/voltpilot-ca.sh init-ca` in the clone; override the location with
# VP_PKI_CA_DIR). Set false if this host must not hold the CA key.
VOLTPILOT_ENROLLMENT_ENABLED=true
# REQUIRED when enrollment is on (the proxied/domain-based production model):
# the hostname enrolled devices are told to dial for MQTT (the dedicated MQTT
# subdomain, a plain DNS A record to this VM - see docs/deploy.md). This name
# MUST be present in the broker server-cert SAN (init-ca --domain), or device
# mTLS fails hostname verification. Leaving it blank silently fell back to
# mqtt.${DOMAIN}, which handed devices the wrong host on 2026-07-03 - so the
# deploy preflight now ABORTS when enrollment is on and this is unset. Set it
# to the exact name your init-ca --domain used (or to <VM-IP> for a raw-IP,
# non-proxied setup). Only leave it unset when VOLTPILOT_ENROLLMENT_ENABLED=false.
MQTT_DOMAIN=mqtt.voltpilot.example.com
# CA working dir on the host (default: ./tools/pki/out/ca inside the clone).
#VP_PKI_CA_DIR=/srv/docker/voltpilot/tools/pki/out/ca
# Enrollment abuse guard (sliding window, same proxy-chain trust model as the
# registration limiter). Defaults accommodate legitimate 30-60 s cert polling.
#VOLTPILOT_ENROLLMENT_RATE_LIMIT_TRUSTED_PROXIES=2
#VOLTPILOT_ENROLLMENT_RATE_LIMIT_PER_CLIENT_MAX=240
#VOLTPILOT_ENROLLMENT_RATE_LIMIT_GLOBAL_MAX=5000
#VOLTPILOT_ENROLLMENT_RATE_LIMIT_WINDOW=PT1H

# --- Auto-reload the broker authorizer on grant write/removal -----------------
# The moment the api writes a device's ACL grant (issuance) or removes it
# (unclaim), it re-initialises EMQX's file authorizer over the internal REST API
# (http://emqx:18083/api/v5), so a freshly claimed device is publishable within
# seconds instead of at the next deploy/cron reload (tools/pki/reload-broker-authz.sh,
# still the backstop). On by default; auth reuses EMQX_DASHBOARD_USER/PASSWORD
# above (no extra secret). Set false to fall back to reload-only-on-deploy/cron.
VOLTPILOT_BROKER_AUTHZ_RELOAD_ENABLED=true

# --- Market data (day-ahead prices) -------------------------------------------
# Price source: `energy-charts` (default, keyless - energy-charts.info by
# Fraunhofer ISE) or `entsoe` (official ENTSO-E Transparency Platform, needs
# ENTSOE_SECURITY_TOKEN below). Switching is config only:
#   docker compose -f docker-compose.prod.yml up -d market-data
MARKET_DATA_SOURCE=energy-charts
MARKET_DATA_ZONE=DE-LU
# Coverage-aware retry around the ~12:45 Berlin day-ahead publication: while
# tomorrow's prices are missing past MARKET_DATA_PUBLICATION_HOUR (decimal
# hours), the collector polls every MARKET_DATA_FAST_REFRESH_SECONDS until they
# land (bounded at midnight); baseline cadence otherwise. Defaults are fine.
MARKET_DATA_FAST_REFRESH_SECONDS=900
MARKET_DATA_PUBLICATION_HOUR=12.75
# ENTSO-E token (only used with MARKET_DATA_SOURCE=entsoe). CAPTAIN-PROVIDED
# secret. Register at https://transparency.entsoe.eu and email
# transparency@entsoe.eu (subject "Restful API access"); the token appears under
# "My Account Settings" -> "Web Api Security Token". A missing/invalid token
# makes the collector log a fetch error each cycle and retry (no crash).
ENTSOE_SECURITY_TOKEN=
ENTSOE_BASE_URL=https://web-api.tp.entsoe.eu/api

# --- Marktstammdatenregister (MaStR, "Anlage verknüpfen") ---------------------
# OPTIONAL. Blank => the api uses the keyless public JSON backend for registry
# lookups (fine to launch with). Set the captain's Webdienstnutzer credentials
# (one-time free registration, see docs/deploy.md) to promote lookups to the
# official SOAP webservice - config only, no redeploy of code.
MASTR_API_KEY=
MASTR_MARKTAKTEUR_NUMMER=

# --- Set by the deploy workflow ----------------------------------------------
# Pinned per rollout to the built image SHA; defaults to latest for a manual
# `docker compose up` on the VPS.
IMAGE_TAG=latest

# ---- Shadow-mode forecasting (docs/forecasting.md) ---------------------------
# Which forecast model the optimizer consumes per kind (also shown as "live" in
# the portal's Prognosequalität). Defaults = the baselines; promoting a proven
# challenger (load-xgb / pv-residual-xgb) is a deliberate flip of these two
# values followed by `docker compose up -d forecast optimization api` - the
# evaluation history in forecast_accuracy is the evidence base. NEVER automatic.
#VOLTPILOT_ACTIVE_LOAD_MODEL=load-persistence
#VOLTPILOT_ACTIVE_PV_MODEL=pv-physical

# ---- Optimizer economics + telemetry freshness (redesign Stage 1) ------------
# Battery wear cost in ct per kWh CYCLED (default 4.0 - LFP-representative,
# derivation in services/optimization config.py; per-asset override via
# asset.wear_cost_ct_per_kwh) and the telemetry freshness windows (stale
# grid_limit_kw = no active limit, stale soc_pct = 50% default).
#OPTIMIZER_WEAR_COST_CT_PER_KWH=4.0
#OPTIMIZER_GRID_LIMIT_MAX_AGE_MINUTES=60
#OPTIMIZER_SOC_MAX_AGE_MINUTES=120

# ---- v1 -> v2 migration switch (MIG; docs/migration-v1-to-v2.md) -------------
# Comma-separated site UUIDs the optimizer ADDITIONALLY publishes a v2 shadow
# plan for (ems/{t}/{s}/{d}/v2/plan). The v1 /schedule plan stays byte-identical
# for every site, so this is safe to flip per site and to roll back by removing
# a site (seconds, no image change). EMPTY (the default) = nothing migrated.
# The api needs NO new env for the conversion/history-bridge/adaptive UI (all
# admin-endpoint- and DB-driven); only the optimizer reads this flag.
#VOLTPILOT_V2_PLAN_SITES=

# Ersparnis-Simulation: parallel solver processes per job in the `simulation`
# service (default 3; the compose service also carries a cpus limit so the
# production optimizer never starves). One-time prerequisite per reference
# year - backfill that year's day-ahead prices (idempotent):
#   docker compose -f docker-compose.prod.yml run --rm market-data backfill --year 2025 --persist
#SIM_MAX_WORKERS=3
